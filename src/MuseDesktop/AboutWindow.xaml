<Window x:Class="MuseDesktop.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About MuseDesktop"
        Width="600" Height="480" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="MuseDesktop" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="TaglineText" Style="{StaticResource Note}" Margin="0,2,0,0"
                       Text="A native Windows client for Muse at muse.ai. An independent open-source project (MIT), not made by Meta."/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="ActionNote" Style="{StaticResource Note}" Margin="0,4,10,0"/>
            <Button Content="Check for updates" Width="140" Height="30" Click="OnCheckForUpdates"
                    ToolTip="Ask GitHub Releases whether a newer MuseDesktop is available (the same check the ⋯ menu runs)"/>
            <Button x:Name="LicensesButton" Content="Licenses &amp; notices" Width="150" Height="30" Margin="8,0,0,0" Click="OnToggleLicenses"
                    ToolTip="MuseDesktop's own MIT license and the notices for the WebView2 SDK and .NET it is built on"/>
            <Button Content="Close" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>

        <TextBox x:Name="FactsText" Margin="0,10,0,0" IsReadOnly="True"
                 FontSize="12.5"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource HairlineBrush}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="About facts"/>
        <TextBox x:Name="LicensesText" Margin="0,10,0,0" IsReadOnly="True" Visibility="Collapsed"
                 FontFamily="Consolas" FontSize="11.5"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource HairlineBrush}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Licenses and third-party notices"/>
    </DockPanel>
</Window>
