<Window x:Class="MuseDesktop.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc about_musedesktop}"
        Width="600" Height="480" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" xmlns:local="clr-namespace:MuseDesktop">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="MuseDesktop" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="TaglineText" Style="{StaticResource Note}" Margin="0,2,0,0"
                       Text="{local:Loc a_native_windows_client_for_muse_at_muse_ai}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="ActionNote" Style="{StaticResource Note}" Margin="0,4,10,0"/>
            <Button Content="{local:Loc check_for_updates}" Width="140" Height="30" Click="OnCheckForUpdates"
                    ToolTip="{local:Loc ask_github_releases_whether_a_newer}" KeyboardNavigation.TabIndex="1"/>
            <Button x:Name="LicensesButton" Content="{local:Loc licenses_notices}" Width="150" Height="30" Margin="8,0,0,0" Click="OnToggleLicenses"
                    ToolTip="{local:Loc musedesktop_s_own_mit_license_and_the}" KeyboardNavigation.TabIndex="2"/>
            <Button Content="{local:Loc close}" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True" KeyboardNavigation.TabIndex="3"/>
        </StackPanel>

        <TextBox x:Name="FactsText" Margin="0,10,0,0" IsReadOnly="True"
                 FontSize="12.5"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource HairlineBrush}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="{local:Loc about_facts}" KeyboardNavigation.TabIndex="4"/>
        <TextBox x:Name="LicensesText" Margin="0,10,0,0" IsReadOnly="True" Visibility="Collapsed"
                 FontFamily="Consolas" FontSize="11.5"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource HairlineBrush}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="{local:Loc licenses_and_third_party_notices}" KeyboardNavigation.TabIndex="5"/>
    </DockPanel>
</Window>
