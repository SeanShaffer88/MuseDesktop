<Window x:Class="MuseDesktop.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help &amp; troubleshooting"
        Width="780" Height="540" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="What's going wrong?" Margin="0,0,0,4"/>
            <TextBox x:Name="SearchText" TextChanged="OnSearchChanged"
                     ToolTip="Describe the problem in a word or two — microphone, sign in, downloads…"
                     AutomationProperties.Name="Search help"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Note}"
                       Text="These pages live inside the app — no internet needed to read them."/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource Note}">
                Still stuck? <Hyperlink NavigateUri="https://github.com/SeanShaffer88/MuseDesktop/issues" RequestNavigate="OnReportLink">Report a problem on GitHub</Hyperlink> — opens in your browser (needs the internet). A support bundle (⋯ → Diagnostics → Export support bundle…) gives whoever helps you the facts without your private data.
            </TextBlock>
            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                <Button x:Name="ActionButton" DockPanel.Dock="Left" Height="30" MinWidth="220" Click="OnAction" Visibility="Collapsed"
                        ToolTip="Open the in-app place this page points at"/>
                <Button Content="Close" DockPanel.Dock="Right" Width="86" Height="30" IsCancel="True"/>
            </DockPanel>
        </StackPanel>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="PageList" Grid.Column="0"
                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource HairlineBrush}"
                     DisplayMemberPath="Title"
                     SelectionChanged="OnPageSelected"
                     AutomationProperties.Name="Help topics"/>
            <TextBox x:Name="BodyText" Grid.Column="2" IsReadOnly="True"
                     FontSize="12.5"
                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource HairlineBrush}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     TextWrapping="Wrap"
                     AutomationProperties.Name="Help page text"/>
        </Grid>
    </DockPanel>
</Window>
