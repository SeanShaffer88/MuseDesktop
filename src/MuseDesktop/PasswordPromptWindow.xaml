<Window x:Class="MuseDesktop.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export password"
        Width="420" Height="270" MinWidth="380" MinHeight="240"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,14">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap"
                   Text="Type the password for this encrypted settings export:"/>
        <PasswordBox x:Name="PasswordEntry" Margin="0,10,0,0"
                     AutomationProperties.Name="Password"/>
        <StackPanel x:Name="ConfirmPanel">
            <TextBlock Text="Type it again to confirm:" Margin="0,10,0,0"/>
            <PasswordBox x:Name="ConfirmEntry" Margin="0,4,0,0"
                         AutomationProperties.Name="Confirm password"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource Note}"
                   Foreground="{StaticResource AccentBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="86" Height="30" IsDefault="True" Click="OnOk"
                    Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"/>
            <Button Content="Cancel" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
