<Window x:Class="MuseDesktop.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc export_password}"
        Width="420" Height="270" MinWidth="380" MinHeight="240"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" xmlns:local="clr-namespace:MuseDesktop">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,14">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap"
                   Text="{local:Loc type_the_password_for_this_encrypted}"/>
        <PasswordBox x:Name="PasswordEntry" Margin="0,10,0,0"
                     AutomationProperties.Name="{local:Loc password}" KeyboardNavigation.TabIndex="1"/>
        <StackPanel x:Name="ConfirmPanel">
            <TextBlock Text="{local:Loc type_it_again_to_confirm}" Margin="0,10,0,0"/>
            <PasswordBox x:Name="ConfirmEntry" Margin="0,4,0,0"
                         AutomationProperties.Name="{local:Loc confirm_password}" KeyboardNavigation.TabIndex="2"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource Note}"
                   Foreground="{StaticResource AccentBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{local:Loc ok}" Width="86" Height="30" IsDefault="True" Click="OnOk"
                    Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0" KeyboardNavigation.TabIndex="3"/>
            <Button Content="{local:Loc cancel}" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True" KeyboardNavigation.TabIndex="4"/>
        </StackPanel>
    </StackPanel>
</Window>
