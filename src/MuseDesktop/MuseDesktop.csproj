<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MuseDesktop</AssemblyName>
    <RootNamespace>MuseDesktop</RootNamespace>
    <Version>0.5.0</Version>
    <!-- Ship only English satellite assemblies: the shell UI is English-only,
         and the self-contained runtime otherwise adds a folder per culture. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Authors>Sean Shaffer</Authors>
    <Description>A native Windows desktop client for Muse (muse.ai).</Description>
    <ApplicationIcon>muse.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Allow building the Windows target on non-Windows machines for CI gates. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MuseDesktop.Core\MuseDesktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window icon is loaded at runtime from a pack resource. It must
         be a WPF Resource: ApplicationIcon alone only embeds the Win32 exe
         icon, and referencing the file from XAML without this crashes
         startup with a XamlParseException (v0.1.0 field bug). -->
    <Resource Include="muse.ico" />
  </ItemGroup>

</Project>
