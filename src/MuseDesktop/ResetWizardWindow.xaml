<Window x:Class="MuseDesktop.ResetWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset MuseDesktop"
        Width="500" SizeToContent="Height" MaxHeight="760"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Step" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,14,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16">
        <TextBlock Text="Reset MuseDesktop" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Note}" FontSize="12" Margin="0,6,0,0"
                   Text="For when MuseDesktop won't start properly or won't sign in. This walks through the reset in order — nothing happens until the last step, and your current settings are backed up before anything changes."/>

        <TextBlock Text="Step 1 — Backup (done for you)" Style="{StaticResource Step}"/>
        <TextBlock x:Name="BackupStatusText" Style="{StaticResource Note}"
                   Text="Writing a backup of your current settings…"/>

        <TextBlock Text="Step 2 — Choose what to reset" Style="{StaticResource Step}"/>
        <CheckBox x:Name="ResetSettingsCheck" Content="Reset my settings to defaults"
                  Checked="OnChoiceChanged" Unchecked="OnChoiceChanged"
                  ToolTip="Preferences (startup, theme, downloads, tray, zoom…) return to their defaults. Profiles, sign-ins, last pages, and downloaded files are never touched by a settings reset"/>
        <TextBlock Style="{StaticResource Note}" Margin="18,0,0,0"
                   Text="Preferences only — your profiles, sign-ins, and files stay. The setup wizard will offer itself again next launch."/>
        <CheckBox x:Name="ClearDataCheck" Content="Clear site data for all profiles"
                  Checked="OnChoiceChanged" Unchecked="OnChoiceChanged"
                  ToolTip="Cookies, cache, and site storage for every profile — this is the step that fixes most sign-in problems"/>
        <TextBlock Style="{StaticResource Note}" Margin="18,0,0,0"
                   Text="Signs every profile out of Muse (your chats are in your Muse account, never at risk). This happens as soon as you run the reset — Settings' Cancel can't undo it."/>

        <TextBlock Text="Step 3 — Run the reset" Style="{StaticResource Step}"/>
        <TextBlock x:Name="ResultText" Style="{StaticResource Note}"
                   Text="Choose at least one thing to reset above, then run it."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RunButton" Content="Run the reset" Width="130" Height="30" Click="OnRunReset" IsEnabled="False"
                    ToolTip="Apply the chosen steps now (you'll be asked to confirm first)"/>
            <Button x:Name="CloseButton" Content="Close" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
