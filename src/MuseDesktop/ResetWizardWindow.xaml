<Window x:Class="MuseDesktop.ResetWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc reset_musedesktop}"
        Width="500" SizeToContent="Height" MaxHeight="760"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" xmlns:local="clr-namespace:MuseDesktop">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Step" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,14,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16">
        <TextBlock Text="{local:Loc reset_musedesktop}" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Note}" FontSize="12" Margin="0,6,0,0"
                   Text="{local:Loc for_when_musedesktop_won_t_start_properly}"/>

        <TextBlock Text="{local:Loc step_1_backup_done_for_you}" Style="{StaticResource Step}"/>
        <TextBlock x:Name="BackupStatusText" Style="{StaticResource Note}"
                   Text="{local:Loc writing_a_backup_of_your_current_settings}"/>

        <TextBlock Text="{local:Loc step_2_choose_what_to_reset}" Style="{StaticResource Step}"/>
        <CheckBox x:Name="ResetSettingsCheck" Content="{local:Loc reset_my_settings_to_defaults}"
                  Checked="OnChoiceChanged" Unchecked="OnChoiceChanged"
                  ToolTip="{local:Loc preferences_startup_theme_downloads_tray}" KeyboardNavigation.TabIndex="1"/>
        <TextBlock Style="{StaticResource Note}" Margin="18,0,0,0"
                   Text="{local:Loc preferences_only_your_profiles_sign_ins_and}"/>
        <CheckBox x:Name="ClearDataCheck" Content="{local:Loc clear_site_data_for_all_profiles}"
                  Checked="OnChoiceChanged" Unchecked="OnChoiceChanged"
                  ToolTip="{local:Loc cookies_cache_and_site_storage_for_every}" KeyboardNavigation.TabIndex="2"/>
        <TextBlock Style="{StaticResource Note}" Margin="18,0,0,0"
                   Text="{local:Loc signs_every_profile_out_of_muse_your_chats}"/>

        <TextBlock Text="{local:Loc step_3_run_the_reset}" Style="{StaticResource Step}"/>
        <TextBlock x:Name="ResultText" Style="{StaticResource Note}"
                   Text="{local:Loc choose_at_least_one_thing_to_reset_above}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RunButton" Content="{local:Loc run_the_reset}" Width="130" Height="30" Click="OnRunReset" IsEnabled="False"
                    ToolTip="{local:Loc apply_the_chosen_steps_now_you_ll_be_asked}" KeyboardNavigation.TabIndex="3"/>
            <Button x:Name="CloseButton" Content="{local:Loc close}" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True" KeyboardNavigation.TabIndex="4"/>
        </StackPanel>
    </StackPanel>
</Window>
