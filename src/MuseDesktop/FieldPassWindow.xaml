<Window x:Class="MuseDesktop.FieldPassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc field_pass}"
        Width="900" Height="620" MinWidth="660" MinHeight="470"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" xmlns:local="clr-namespace:MuseDesktop">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="{local:Loc field_pass}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0" Text="{local:Loc fieldpass.subtitle}"/>
            </StackPanel>
            <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Right"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="{local:Loc fieldpass.progress_label}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <ProgressBar x:Name="PassProgressBar" Height="6" Margin="0,4,0,0" Minimum="0"
                                 Background="{StaticResource RaisedBrush}" Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 AutomationProperties.Name="{local:Loc fieldpass.progress_label}"/>
                    <TextBlock x:Name="RemainingText" Style="{StaticResource Note}"/>
                </StackPanel>
                <ListBox x:Name="StepsList"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource HairlineBrush}"
                         SelectionChanged="OnStepSelected"
                         AutomationProperties.Name="{local:Loc fieldpass.steps_name}" KeyboardNavigation.TabIndex="1"/>
            </DockPanel>

            <StackPanel Grid.Column="2">
                <TextBlock x:Name="StepTitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource PanelLabel}" Text="{local:Loc fieldpass.what_to_do}"/>
                <TextBlock x:Name="InstructionsText" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource PanelLabel}" Text="{local:Loc fieldpass.working_looks_like}"/>
                <TextBlock x:Name="SuccessText" TextWrapping="Wrap"/>
                <Button x:Name="OpenFeatureButton" Content="{local:Loc fieldpass.open_feature}" HorizontalAlignment="Left"
                        Width="170" Height="28" Margin="0,14,0,0" Click="OnOpenFeature" KeyboardNavigation.TabIndex="2"
                        ToolTip="{local:Loc fieldpass.open_feature_tooltip}"/>
                <TextBlock Style="{StaticResource PanelLabel}" Text="{local:Loc fieldpass.notes_label}"/>
                <TextBox x:Name="NotesBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource HairlineBrush}"
                         TextChanged="OnNotesChanged"
                         AutomationProperties.Name="{local:Loc fieldpass.notes_name}" KeyboardNavigation.TabIndex="3"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="PassButton" Content="{local:Loc fieldpass.pass}" Width="150" Height="32" Click="OnPass"
                            Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"
                            KeyboardNavigation.TabIndex="4" ToolTip="{local:Loc fieldpass.pass_tooltip}"/>
                    <Button x:Name="ProblemButton" Content="{local:Loc fieldpass.problem}" Width="150" Height="32" Margin="8,0,0,0" Click="OnProblem"
                            KeyboardNavigation.TabIndex="5" ToolTip="{local:Loc fieldpass.problem_tooltip}"/>
                    <Button x:Name="SkipButton" Content="{local:Loc fieldpass.skip}" Width="150" Height="32" Margin="8,0,0,0" Click="OnSkip"
                            KeyboardNavigation.TabIndex="6" ToolTip="{local:Loc fieldpass.skip_tooltip}"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Note}" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource Note}" Margin="0,0,0,0" Text="{local:Loc fieldpass.footer}"/>
            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                <Button x:Name="CopySummaryButton" DockPanel.Dock="Left" Content="{local:Loc fieldpass.copy_summary}" Width="130" Height="30" Click="OnCopySummary"
                        KeyboardNavigation.TabIndex="7" ToolTip="{local:Loc fieldpass.copy_summary_tooltip}"/>
                <Button x:Name="StartOverButton" DockPanel.Dock="Left" Content="{local:Loc fieldpass.start_over}" Width="110" Height="30" Margin="8,0,0,0" Click="OnStartOver"
                        KeyboardNavigation.TabIndex="8" ToolTip="{local:Loc fieldpass.start_over_tooltip}"/>
                <TextBlock x:Name="CopyNote" DockPanel.Dock="Left" Style="{StaticResource Note}" Margin="10,6,0,0"/>
                <Button Content="{local:Loc close}" DockPanel.Dock="Right" Width="86" Height="30" IsCancel="True" KeyboardNavigation.TabIndex="9"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
