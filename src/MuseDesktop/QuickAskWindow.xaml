<Window x:Class="MuseDesktop.QuickAskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MuseDesktop"
        Title="{local:Loc quickask.window_title}"
        Width="460" Height="640" MinWidth="320" MinHeight="420"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The page itself: the Muse page on a fresh conversation.
             Its own composer is the input — the shell adds no box of
             its own and never sends anything here. -->
        <Border Grid.Row="0" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
            <Grid x:Name="WebHost"/>
        </Border>

        <!-- The footer bar: the one shell action (hand this
             conversation to the main window) and the close hint. -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="ContinueButton" DockPanel.Dock="Left" MinWidth="180" Padding="10,4"
                    Content="{local:Loc quickask.continue_in_main_window}" Click="OnContinueInMainWindow"
                    ToolTip="{local:Loc quickask.continue_tooltip}"
                    AutomationProperties.Name="{local:Loc quickask.continue_in_main_window}"
                    KeyboardNavigation.TabIndex="1"/>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                       Text="{local:Loc quickask.esc_hint}" Foreground="{StaticResource MutedBrush}"/>
        </DockPanel>
    </Grid>
</Window>
