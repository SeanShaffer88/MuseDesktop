<Window x:Class="MuseDesktop.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to MuseDesktop"
        Width="470" SizeToContent="Height" MaxHeight="720"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16">
        <TextBlock Text="Welcome to MuseDesktop" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Note}" FontSize="12" Margin="0,6,0,4"
                   Text="Muse now has its own window on your PC. Four quick choices set it up the way you like — every one of them can be changed later in Settings (⋯ menu → Settings…, or Ctrl+,)."/>
        <CheckBox x:Name="CloseToTrayCheck" Content="Close window to tray (instead of quitting)"
                  ToolTip="The X button hides the window to the system tray; Exit lives on the tray menu"/>
        <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows"
                  ToolTip="Launch MuseDesktop when you sign in — it waits in the tray until you open it"/>
        <TextBlock Style="{StaticResource Note}" Margin="0,12,0,2"
                   Text="Where downloads are saved (empty = your Windows Downloads folder):"/>
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Browse…" Width="76" Margin="8,0,0,0"
                    Click="OnBrowseDownloadsFolder"/>
            <TextBox x:Name="DownloadsFolderText" IsReadOnly="True"
                     ToolTip="Where files Muse makes for you are saved"/>
        </DockPanel>
        <CheckBox x:Name="CheckUpdatesCheck" Content="Check for updates when the app starts"
                  ToolTip="One silent request to GitHub Releases per launch; failures are ignored"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save setup" Width="96" Height="30" IsDefault="True" Click="OnSave"
                    Background="{StaticResource AccentFillBrush}" Foreground="White" BorderThickness="0"/>
            <Button Content="Skip" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True" Click="OnSkip"/>
        </StackPanel>
    </StackPanel>
</Window>
