<Window x:Class="MuseDesktop.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc welcome_to_musedesktop}"
        Width="470" SizeToContent="Height" MaxHeight="720"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" xmlns:local="clr-namespace:MuseDesktop">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16">
        <TextBlock Text="{local:Loc welcome_to_musedesktop}" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Note}" FontSize="12" Margin="0,6,0,4"
                   Text="{local:Loc muse_now_has_its_own_window_on_your_pc_four}"/>
        <CheckBox x:Name="CloseToTrayCheck" Content="{local:Loc close_window_to_tray_instead_of_quitting}"
                  ToolTip="{local:Loc the_x_button_hides_the_window_to_the_system}" KeyboardNavigation.TabIndex="1"/>
        <CheckBox x:Name="StartWithWindowsCheck" Content="{local:Loc start_with_windows}"
                  ToolTip="{local:Loc launch_musedesktop_when_you_sign_in_it}" KeyboardNavigation.TabIndex="2"/>
        <TextBlock Style="{StaticResource Note}" Margin="0,12,0,2"
                   Text="{local:Loc where_downloads_are_saved_empty_your}"/>
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="{local:Loc browse}" Width="76" Margin="8,0,0,0"
                    Click="OnBrowseDownloadsFolder" KeyboardNavigation.TabIndex="3"/>
            <TextBox x:Name="DownloadsFolderText" IsReadOnly="True"
                     ToolTip="{local:Loc where_files_muse_makes_for_you_are_saved}" KeyboardNavigation.TabIndex="4"/>
        </DockPanel>
        <CheckBox x:Name="CheckUpdatesCheck" Content="{local:Loc check_for_updates_when_the_app_starts}"
                  ToolTip="{local:Loc one_silent_request_to_github_releases_per}" KeyboardNavigation.TabIndex="5"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{local:Loc save_setup}" Width="96" Height="30" IsDefault="True" Click="OnSave"
                    Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0" KeyboardNavigation.TabIndex="6"/>
            <Button Content="{local:Loc skip}" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True" Click="OnSkip" KeyboardNavigation.TabIndex="7"/>
        </StackPanel>
    </StackPanel>
</Window>
