<Window x:Class="MuseDesktop.ScheduleRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc scheduled_command}"
        Width="460" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="Height"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" xmlns:local="clr-namespace:MuseDesktop">
    <StackPanel Margin="18,14,18,14">
        <TextBlock Text="{local:Loc run_this_command}"/>
        <ComboBox x:Name="ActionCombo" Margin="0,6,0,0" DisplayMemberPath="Title"
                  AutomationProperties.Name="{local:Loc command_to_run}" KeyboardNavigation.TabIndex="1"/>
        <TextBlock Text="{local:Loc when}" Margin="0,12,0,0"/>
        <ComboBox x:Name="TriggerCombo" Margin="0,6,0,0"
                  SelectionChanged="OnTriggerChanged"
                  AutomationProperties.Name="{local:Loc when_to_run_it}" KeyboardNavigation.TabIndex="2">
            <ComboBoxItem Content="{local:Loc at_startup}"/>
            <ComboBoxItem Content="{local:Loc daily_at_a_time}"/>
            <ComboBoxItem Content="{local:Loc once_at_a_date_and_time}"/>
        </ComboBox>
        <StackPanel x:Name="DailyPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock Text="{local:Loc time_of_day_24h}" VerticalAlignment="Center"/>
            <TextBox x:Name="DailyTimeText" Width="70" Margin="8,0,0,0" Text="09:00"
                     AutomationProperties.Name="{local:Loc daily_time_hours_and_minutes}" KeyboardNavigation.TabIndex="3"/>
        </StackPanel>
        <StackPanel x:Name="OncePanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock Text="{local:Loc date}" VerticalAlignment="Center"/>
            <TextBox x:Name="OnceDateText" Width="104" Margin="8,0,0,0"
                     AutomationProperties.Name="{local:Loc one_off_date_year_month_day}" KeyboardNavigation.TabIndex="4"/>
            <TextBlock Text="{local:Loc time}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="OnceTimeText" Width="70" Margin="8,0,0,0" Text="09:00"
                     AutomationProperties.Name="{local:Loc one_off_time_hours_and_minutes}" KeyboardNavigation.TabIndex="5"/>
        </StackPanel>
        <CheckBox x:Name="EnabledCheck" Content="{local:Loc enabled}" IsChecked="True" Margin="0,12,0,0" KeyboardNavigation.TabIndex="6"/>
        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource MutedBrush}"
                   Text="{local:Loc schedules_run_only_while_musedesktop_is}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="{local:Loc ok}" Width="86" Height="30" IsDefault="True" Click="OnOk"
                    Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0" KeyboardNavigation.TabIndex="7"/>
            <Button Content="{local:Loc cancel}" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True" KeyboardNavigation.TabIndex="8"/>
        </StackPanel>
    </StackPanel>
</Window>
