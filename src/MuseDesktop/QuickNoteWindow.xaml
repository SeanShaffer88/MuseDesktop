<Window x:Class="MuseDesktop.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc quick_note_2}"
        Width="480" MinWidth="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" SizeToContent="Height"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" xmlns:local="clr-namespace:MuseDesktop">
    <StackPanel Margin="18,14,18,14">
        <TextBlock Text="{local:Loc a_note_for_the_profile_you_re_using_saved}"
                   TextWrapping="Wrap"/>
        <TextBox x:Name="NoteText" Margin="0,10,0,0" Height="110"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource HairlineBrush}"
                 AutomationProperties.Name="{local:Loc note_text}" KeyboardNavigation.TabIndex="1"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="{local:Loc save_note}" Width="96" Height="30" IsDefault="True" Click="OnSave"
                    Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0" KeyboardNavigation.TabIndex="2"/>
            <Button Content="{local:Loc cancel}" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True" KeyboardNavigation.TabIndex="3"/>
        </StackPanel>
    </StackPanel>
</Window>
