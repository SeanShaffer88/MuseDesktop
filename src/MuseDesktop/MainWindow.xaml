<Window x:Class="MuseDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Muse"
        Width="1280" Height="860"
        MinWidth="720" MinHeight="480"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="Manual">
    <!-- S11 #98: AllowDrop + the drag handlers live on the root grid.
         They only ever see drags over the shell chrome — the WebView2
         child window owns its own OLE drop target, so file drops onto
         the Muse page go straight to the page (as they always have);
         the handlers light the frame ring and point at the page. -->
    <Grid AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver"
          DragLeave="OnDragLeave" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border x:Name="Toolbar" Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True" Margin="6,0">
                <!-- The two button strips are named: S5 #45 rebuilds their
                     contents from the user's toolbar layout at startup. The
                     ⋯ menu button stays fixed, last in the right strip. -->
                <StackPanel x:Name="LeftStrip" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource BarButton}" Content="&#x2190;"
                            ToolTip="Back (Alt+Left). Right-click for history." Click="OnBack" AutomationProperties.Name="Back"
                            PreviewMouseRightButtonUp="OnBackHistoryMenu"
                            PreviewMouseLeftButtonDown="OnNavButtonPress" PreviewMouseLeftButtonUp="OnNavButtonRelease"/>
                    <Button x:Name="ForwardButton" Style="{StaticResource BarButton}" Content="&#x2192;"
                            ToolTip="Forward (Alt+Right). Right-click for history." Click="OnForward" AutomationProperties.Name="Forward"
                            PreviewMouseRightButtonUp="OnForwardHistoryMenu"
                            PreviewMouseLeftButtonDown="OnNavButtonPress" PreviewMouseLeftButtonUp="OnNavButtonRelease"/>
                    <Button x:Name="ReloadButton" Style="{StaticResource BarButton}" Content="&#x27F3;"
                            ToolTip="Reload (Ctrl+R / F5)" Click="OnReload" AutomationProperties.Name="Reload"/>
                    <Button x:Name="HomeButton" Style="{StaticResource BarButton}" Content="&#x2302;"
                            ToolTip="Muse home" Click="OnHome" AutomationProperties.Name="Home"/>
                </StackPanel>

                <StackPanel x:Name="RightStrip" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource BarButton}" Content="&#x2212;" Width="28"
                            ToolTip="Zoom out (Ctrl+-)" Click="OnZoomOut" AutomationProperties.Name="Zoom out"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%" Width="42" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               ToolTip="Current zoom. Ctrl+0 resets."/>
                    <Button x:Name="ZoomInButton" Style="{StaticResource BarButton}" Content="+" Width="28"
                            ToolTip="Zoom in (Ctrl++)" Click="OnZoomIn" AutomationProperties.Name="Zoom in"/>
                    <Button x:Name="PinButton" Style="{StaticResource BarButton}" Content="&#x1F4CC;" Width="28"
                            ToolTip="Keep this window on top" Click="OnTogglePin"
                            AutomationProperties.Name="Always on top"/>
                    <Button x:Name="BrowserButton" Style="{StaticResource BarButton}" Content="&#x2197;"
                            ToolTip="Open this page in your default browser" Click="OnOpenInBrowser"
                            AutomationProperties.Name="Open in browser"/>
                    <Button x:Name="MenuButton" Style="{StaticResource BarButton}" Content="&#x22EF;"
                            ToolTip="More options" Click="OnMenu" AutomationProperties.Name="More options">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu">
                                <MenuItem x:Name="ProfileItem" Header="Profile: Default" IsEnabled="False" Visibility="Collapsed"/>
                                <Separator x:Name="ProfileSeparator" Visibility="Collapsed"/>
                                <MenuItem x:Name="SwitchProfileItem" Header="Switch profile"
                                          ToolTip="Restart MuseDesktop signed in with another profile"/>
                                <MenuItem Header="Settings…" Click="OnSettings" InputGestureText="Ctrl+,"
                                          ToolTip="Startup, downloads, updates, memory, and data options"/>
                                <MenuItem x:Name="UpdateItem" Header="Check for updates" Click="OnCheckForUpdates"
                                          ToolTip="See whether a newer MuseDesktop is available"/>
                                <MenuItem Header="Downloads…" Click="OnDownloads"
                                          ToolTip="Files Muse has downloaded for you, newest first"/>
                                <MenuItem Header="Command palette…" Click="OnCommandPalette" InputGestureText="Ctrl+K"
                                          ToolTip="Every action, profile, setting, download, and window — searchable from the keyboard"/>
                                <MenuItem Header="Switch window…" Click="OnSwitchWindow"
                                          ToolTip="Jump to another open MuseDesktop window, most recently used first"/>
                                <MenuItem x:Name="WorkspacesItem" Header="Workspaces"
                                          ToolTip="Apply a saved workspace — a named set of windows (profile, placement, and Muse section)"/>
                                <MenuItem Header="Save current arrangement as workspace" Click="OnSaveWorkspace"
                                          ToolTip="Save the open windows as a workspace you can re-apply any time"/>
                                <MenuItem Header="Take session snapshot" Click="OnTakeSessionSnapshot"
                                          ToolTip="Remember the open windows once (sections only, never full page addresses)"/>
                                <MenuItem Header="Restore session snapshot" Click="OnRestoreSessionSnapshot"
                                          ToolTip="Bring back the windows from the last session snapshot"/>
                                <Separator/>
                                <MenuItem Header="Find in page…" Click="OnFind" InputGestureText="Ctrl+F"/>
                                <MenuItem Header="Keyboard shortcuts…" Click="OnShortcuts" InputGestureText="Ctrl+/"
                                          ToolTip="Every keyboard shortcut in one searchable list; three of them can be changed in Settings"/>
                                <MenuItem Header="Print…" Click="OnPrint" InputGestureText="Ctrl+P"/>
                                <MenuItem Header="Save as PDF…" Click="OnSaveAsPdf"/>
                                <MenuItem Header="Copy page address" Click="OnCopyPageAddress"/>
                                <MenuItem Header="Open in browser" Click="OnOpenInBrowser"/>
                                <MenuItem Header="Open in new window" Click="OnOpenInNewWindow"
                                          ToolTip="Open the current page in a second window on the same profile"/>
                                <Separator/>
                                <MenuItem x:Name="PinItem" Header="Always on top" IsCheckable="True" Click="OnTogglePin"
                                          ToolTip="Keep MuseDesktop above other windows"/>
                                <MenuItem x:Name="FocusItem" Header="Focus mode" IsCheckable="True" Click="OnToggleFocusMode"
                                          InputGestureText="F8" ToolTip="Hide the toolbar and status bar (F8 or Esc to exit)"/>
                                <MenuItem Header="Restore last closed page" Click="OnRestoreClosedPage" InputGestureText="Ctrl+Shift+T"/>
                                <Separator/>
                                <MenuItem Header="Connection security…" Click="OnConnectionSecurity"
                                          ToolTip="The current site's connection: address, encryption, and the WebView2 runtime version"/>
                                <MenuItem x:Name="LockNowItem" Header="Lock now" Click="OnLockNow" Visibility="Collapsed"
                                          ToolTip="Lock MuseDesktop with your app password until you unlock it"/>
                                <MenuItem Header="View log…" Click="OnViewLog"
                                          ToolTip="Read the diagnostic log in the app, with its redaction check"/>
                                <MenuItem Header="Open log folder" Click="OnOpenLogFolder"/>
                                <MenuItem Header="Diagnostics…" Click="OnDiagnostics"
                                          ToolTip="Versions, runtime health, proxy, memory, startup timings, data sizes, and recent errors — with a Copy button and the support-bundle export"/>
                                <MenuItem Header="Help &amp; troubleshooting…" Click="OnHelp"
                                          ToolTip="Offline pages for the common problems: sign-in loops, microphone, silent notifications, missing runtime, failing downloads, a forgotten app password"/>
                                <MenuItem Header="Export support bundle…" Click="OnExportSupportBundle"
                                          ToolTip="One .zip with the diagnostics report, the redacted log tail, sanitized settings, and download history — previewed first, uploaded nowhere"/>
                                <MenuItem Header="About MuseDesktop" Click="OnAbout"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" Text="Muse" Margin="8,0,0,0" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="AddressText" Text="" Margin="10,0,0,0" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource FaintBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Find bar (v0.5.0, S1 #1) -->
        <Border x:Name="FindBar" Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="6,3" VerticalAlignment="Center">
                <TextBox x:Name="FindTextBox" Width="220" Height="24" VerticalContentAlignment="Center"
                         Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource HairlineBrush}"
                         KeyDown="OnFindTextKeyDown" TextChanged="OnFindTextChanged"
                         AutomationProperties.Name="Find in page"/>
                <TextBlock x:Name="FindCountText" Text="" Margin="8,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <Button Style="{StaticResource BarButton}" Content="&#x2191;" Width="28"
                        ToolTip="Previous match (Shift+Enter)" Click="OnFindPrevious" AutomationProperties.Name="Previous match"/>
                <Button Style="{StaticResource BarButton}" Content="&#x2193;" Width="28"
                        ToolTip="Next match (Enter)" Click="OnFindNext" AutomationProperties.Name="Next match"/>
                <Button Style="{StaticResource BarButton}" Content="&#x2715;" Width="28"
                        ToolTip="Close find (Esc)" Click="OnFindClose" AutomationProperties.Name="Close find"/>
            </StackPanel>
        </Border>

        <!-- Web content. The first-run / error overlay sits above it until the page loads.
             ContentGrid is named because S8 #71's recovery replaces the web
             view controls inside it when the browser process exits. -->
        <Grid Grid.Row="2" x:Name="ContentGrid">
            <!-- Focus ring (S6 #58): the border is always 2px (so the
                 page never shifts); its brush turns accent-colored
                 while keyboard focus is inside the page, transparent
                 while focus is on the shell chrome. -->
            <Border x:Name="WebFocusRing" BorderThickness="2" BorderBrush="Transparent">
                <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#0B0B0D"
                              AutomationProperties.Name="Muse web content"/>
            </Border>
            <!-- Hidden retry view (S2 #15): same environment/profile, used only to
                 re-issue a download that failed in this session. Never shown. -->
            <wv2:WebView2 x:Name="RetryBrowser" Width="1" Height="1" Visibility="Hidden"
                          IsHitTestVisible="False" DefaultBackgroundColor="#0B0B0D"/>
            <!-- S8 #80: the hung-page banner. Non-modal on purpose —
                 the user may be mid-voice-call; the page is never
                 reloaded without their say-so. -->
            <Border x:Name="WatchdogBanner" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12,9"
                    AutomationProperties.Name="Page not responding notice">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" MaxWidth="420"
                               TextWrapping="Wrap"
                               Text="The page hasn't answered MuseDesktop's last two checks — it may be busy or hung. Nothing has been reloaded; reload only when it won't interrupt you."/>
                    <Button Content="Reload the page" Margin="12,0,0,0" Padding="10,4" Click="OnWatchdogReload"
                            ToolTip="Reload now — chat drafts and scroll position can be lost"/>
                    <Button Content="Wait" Margin="8,0,0,0" Padding="10,4" Click="OnWatchdogWait"
                            ToolTip="Leave the page exactly as it is; don't check again for 2 minutes"/>
                </StackPanel>
            </Border>
            <Border x:Name="Overlay" Background="{StaticResource BgBrush}" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock x:Name="OverlayTitle" Text="Connecting to Muse…" FontSize="20"
                               FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OverlayBody" Text="" FontSize="13" Margin="0,10,0,0"
                               Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="OverlayButton" Content="Retry" Width="110" Height="32" Margin="0,18,0,0"
                            Visibility="Collapsed" Click="OnReload" HorizontalAlignment="Center"
                            Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border x:Name="StatusBar" Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True" Margin="8,0">
                <Button x:Name="CancelDownloadButton" DockPanel.Dock="Right" Content="&#x2715;" Width="22" Height="18"
                        Visibility="Collapsed" ToolTip="Cancel the most recent download (Downloads… manages each one)" Click="OnCancelDownload"
                        Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0"
                        AutomationProperties.Name="Cancel download"/>
                <!-- Live regions (S6 #54): zero-width, invisible, not
                     hit-testable — present in the UIA tree only, so
                     screen readers speak download/update events. -->
                <TextBlock x:Name="LiveRegionPolite" DockPanel.Dock="Right" Width="0" Opacity="0"
                           IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="LiveRegionAssertive" DockPanel.Dock="Right" Width="0" Opacity="0"
                           IsHitTestVisible="False" AutomationProperties.LiveSetting="Assertive"/>
                <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" FontSize="11"
                           Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Starting…" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MouseLeftButtonUp="OnStatusTextClick"
                           ToolTip=""/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
