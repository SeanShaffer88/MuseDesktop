<Window x:Class="MuseDesktop.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command palette"
        Width="580" Height="440" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="4,8,4,2"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Search commands, downloads, notes, bookmarks, snippets, and pages…"/>
            <TextBox x:Name="SearchText" Margin="0,6,0,0" Height="26" VerticalContentAlignment="Center"
                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource HairlineBrush}"
                     TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
                     ToolTip="Search actions and your local content — a few letters are enough"
                     AutomationProperties.Name="Search commands and local content"/>
        </StackPanel>

        <TextBlock x:Name="SummaryText" DockPanel.Dock="Bottom" Style="{StaticResource Note}"
                   AutomationProperties.Name="Result summary"/>

        <ListBox x:Name="ResultList" Margin="0,10,0,0"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource HairlineBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 MouseDoubleClick="OnDoubleClick" PreviewKeyDown="OnListKeyDown"
                 SelectionChanged="OnSelectionChanged"
                 AutomationProperties.Name="Command results">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeader}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{Binding DotBrush}" Visibility="{Binding DotVisibility}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Gesture}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,2,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
