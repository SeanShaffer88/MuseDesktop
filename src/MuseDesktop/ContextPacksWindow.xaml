<Window x:Class="MuseDesktop.ContextPacksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MuseDesktop"
        Title="{local:Loc context_pack.title}"
        Width="940" Height="640" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,12" AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{local:Loc context_pack.title}" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Note}" Margin="0,2,0,0"
                       Text="{local:Loc context_pack.intro}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="288"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelLabel}" Margin="0"
                           Text="{local:Loc context_pack.packs}"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="NewPackButton" Content="{local:Loc context_pack.new_pack}" Width="92" Height="28"
                            Click="OnNewPack" KeyboardNavigation.TabIndex="1"/>
                    <Button x:Name="RenamePackButton" Content="{local:Loc context_pack.rename_pack}" Width="104" Height="28"
                            Margin="8,0,0,0" Click="OnRenamePack" KeyboardNavigation.TabIndex="2"/>
                    <Button x:Name="DeletePackButton" Content="{local:Loc context_pack.delete_pack}" Width="76" Height="28"
                            Margin="8,0,0,0" Click="OnDeletePack" KeyboardNavigation.TabIndex="3"/>
                </StackPanel>
                <ListBox x:Name="PackList" Margin="0,2,0,0"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource HairlineBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="OnPackSelected"
                         AutomationProperties.Name="{local:Loc context_pack.packs}" KeyboardNavigation.TabIndex="4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,3">
                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource PanelLabel}" Margin="0"
                           Text="{local:Loc context_pack.items}"/>
                <ListBox x:Name="ItemList" Grid.Row="1" Margin="0,2,0,0"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource HairlineBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="OnItemSelected"
                         AutomationProperties.Name="{local:Loc context_pack.items}" KeyboardNavigation.TabIndex="5">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,3">
                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid x:Name="NoteEditorPanel" Grid.Row="2" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource PanelLabel}" Margin="0"
                               Text="{local:Loc context_pack.note_title}"/>
                    <TextBox x:Name="NoteTitleBox" Grid.Row="1" Height="26"
                             Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource HairlineBrush}"
                             AutomationProperties.Name="{local:Loc context_pack.note_title}" KeyboardNavigation.TabIndex="6"/>
                    <TextBox x:Name="NoteTextBox" Grid.Row="2" Height="76" Margin="0,8,0,0"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource HairlineBrush}"
                             AutomationProperties.Name="{local:Loc context_pack.note_text}" KeyboardNavigation.TabIndex="7"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="SaveNoteButton" Content="{local:Loc context_pack.save_note}" Width="104" Height="28"
                                Click="OnSaveNote" KeyboardNavigation.TabIndex="8"/>
                        <Button Content="{local:Loc cancel}" Width="84" Height="28" Margin="8,0,0,0"
                                Click="OnCancelNote" KeyboardNavigation.TabIndex="9"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SnippetPickerPanel" Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource PanelLabel}" Margin="0"
                               Text="{local:Loc context_pack.choose_snippet}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <ComboBox x:Name="SnippetCombo" Width="360" Height="28" DisplayMemberPath="Name"
                                  AutomationProperties.Name="{local:Loc context_pack.choose_snippet}" KeyboardNavigation.TabIndex="10"/>
                        <Button x:Name="AddSnippetButton" Content="{local:Loc context_pack.add_chosen_snippet}" Width="112" Height="28"
                                Margin="8,0,0,0" Click="OnAddChosenSnippet" KeyboardNavigation.TabIndex="11"/>
                        <Button Content="{local:Loc cancel}" Width="84" Height="28" Margin="8,0,0,0"
                                Click="OnCancelSnippet" KeyboardNavigation.TabIndex="12"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ReadingPickerPanel" Grid.Row="4" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource PanelLabel}" Margin="0"
                               Text="{local:Loc context_pack.choose_reading}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <ComboBox x:Name="ReadingCombo" Width="360" Height="28" DisplayMemberPath="Title"
                                  AutomationProperties.Name="{local:Loc context_pack.choose_reading}" KeyboardNavigation.TabIndex="13"/>
                        <Button x:Name="AddReadingButton" Content="{local:Loc context_pack.add_chosen_reading}" Width="112" Height="28"
                                Margin="8,0,0,0" Click="OnAddChosenReading" KeyboardNavigation.TabIndex="14"/>
                        <Button Content="{local:Loc cancel}" Width="84" Height="28" Margin="8,0,0,0"
                                Click="OnCancelReading" KeyboardNavigation.TabIndex="15"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AddFileButton" Content="{local:Loc context_pack.add_file}" Width="96" Height="28"
                            Click="OnAddFile" KeyboardNavigation.TabIndex="16"/>
                    <Button x:Name="AddNoteButton" Content="{local:Loc context_pack.add_note}" Width="104" Height="28"
                            Margin="8,0,0,0" Click="OnAddNote" KeyboardNavigation.TabIndex="17"/>
                    <Button x:Name="AddSnippetItemButton" Content="{local:Loc context_pack.add_snippet}" Width="116" Height="28"
                            Margin="8,0,0,0" Click="OnAddSnippet" KeyboardNavigation.TabIndex="18"/>
                    <Button x:Name="AddReadingItemButton" Content="{local:Loc context_pack.add_reading}" Width="132" Height="28"
                            Margin="8,0,0,0" Click="OnAddReading" KeyboardNavigation.TabIndex="19"/>
                    <Button x:Name="RemoveItemButton" Content="{local:Loc context_pack.remove_item}" Width="104" Height="28"
                            Margin="8,0,0,0" Click="OnRemoveItem" KeyboardNavigation.TabIndex="20"/>
                    <Button x:Name="StartButton" Content="{local:Loc context_pack.start_conversation}" Width="248" Height="28"
                            Margin="16,0,0,0" Click="OnStartConversation"
                            Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"
                            ToolTip="{local:Loc context_pack.start_tooltip}" KeyboardNavigation.TabIndex="21"/>
                </StackPanel>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True">
            <Button x:Name="UndoDeleteButton" DockPanel.Dock="Right" Content="{local:Loc context_pack.undo_delete}"
                    Width="112" Height="28" Margin="8,0,0,0" Click="OnUndoDelete" Visibility="Collapsed"
                    KeyboardNavigation.TabIndex="22"/>
            <Button DockPanel.Dock="Right" Content="{local:Loc close}" Width="84" Height="28"
                    Margin="8,0,0,0" IsCancel="True" KeyboardNavigation.TabIndex="23"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource Note}" Margin="0,4,0,0"/>
        </DockPanel>
    </Grid>
</Window>
