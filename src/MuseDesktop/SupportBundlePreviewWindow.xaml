<Window x:Class="MuseDesktop.SupportBundlePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc export_support_bundle_2}"
        Width="620" Height="600" MinWidth="500" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" xmlns:local="clr-namespace:MuseDesktop">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                   Text="{local:Loc a_support_bundle_collects_the_facts_someone}"/>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="CaptureNote" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{local:Loc choose_where_to_save}" Width="170" Height="30" Click="OnConfirm"
                        Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"
                        ToolTip="{local:Loc pick_the_zip_s_name_and_folder_the_bundle}" KeyboardNavigation.TabIndex="1"/>
                <Button Content="{local:Loc cancel}" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True" KeyboardNavigation.TabIndex="2"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>
                <TextBox x:Name="PreviewText" IsReadOnly="True"
                         FontSize="12.5"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource HairlineBrush}"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="{local:Loc what_the_support_bundle_contains}" KeyboardNavigation.TabIndex="3"/>
                <CheckBox x:Name="ScreenshotCheck" Content="{local:Loc include_a_screenshot_of_the_musedesktop}"
                          Margin="0,12,0,0" Checked="OnScreenshotToggled" Unchecked="OnScreenshotToggled"
                          ToolTip="{local:Loc captures_only_the_musedesktop_window_never}" KeyboardNavigation.TabIndex="4"/>
                <TextBlock x:Name="ScreenshotUnavailableText" Style="{StaticResource Note}" Visibility="Collapsed"/>
                <TextBlock x:Name="ScreenshotWarningText" Style="{StaticResource Note}" Visibility="Collapsed"
                           Text="{local:Loc this_may_include_your_conversation_text}"/>
                <Image x:Name="ScreenshotPreview" Margin="0,8,0,0" MaxHeight="240" Stretch="Uniform"
                       HorizontalAlignment="Left" Visibility="Collapsed"
                       AutomationProperties.Name="{local:Loc screenshot_preview}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
