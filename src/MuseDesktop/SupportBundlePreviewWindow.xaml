<Window x:Class="MuseDesktop.SupportBundlePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export support bundle"
        Width="620" Height="600" MinWidth="500" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap"
                   Text="A support bundle collects the facts someone needs to help you — without your private data. Nothing is uploaded: you save the file, and you decide whether to share it."/>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="CaptureNote" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Choose where to save…" Width="170" Height="30" Click="OnConfirm"
                        Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"
                        ToolTip="Pick the .zip's name and folder; the bundle is written there"/>
                <Button Content="Cancel" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>
                <TextBox x:Name="PreviewText" IsReadOnly="True"
                         FontSize="12.5"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource HairlineBrush}"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="What the support bundle contains"/>
                <CheckBox x:Name="ScreenshotCheck" Content="Include a screenshot of the MuseDesktop window"
                          Margin="0,12,0,0" Checked="OnScreenshotToggled" Unchecked="OnScreenshotToggled"
                          ToolTip="Captures ONLY the MuseDesktop window — never your desktop or other apps. Off by default"/>
                <TextBlock x:Name="ScreenshotUnavailableText" Style="{StaticResource Note}" Visibility="Collapsed"/>
                <TextBlock x:Name="ScreenshotWarningText" Style="{StaticResource Note}" Visibility="Collapsed"
                           Text="This may include your conversation text. Review it before sharing; you can blur or crop it in Paint first. The screenshot shows exactly the MuseDesktop window — no other windows, not your desktop."/>
                <Image x:Name="ScreenshotPreview" Margin="0,8,0,0" MaxHeight="240" Stretch="Uniform"
                       HorizontalAlignment="Left" Visibility="Collapsed"
                       AutomationProperties.Name="Screenshot preview"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
