<Window x:Class="MuseDesktop.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MuseDesktop is locked"
        Width="400" Height="300" MinWidth="360" MinHeight="270"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="MuseDesktop is locked" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                   Text="Type your app password or PIN to keep using MuseDesktop. Your chats and sign-ins are untouched — this only unlocks the app on this PC."/>
        <PasswordBox x:Name="PasswordEntry" Margin="0,14,0,0"
                     AutomationProperties.Name="App password"
                     KeyDown="OnPasswordKeyDown"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource Note}"
                   Foreground="{StaticResource AccentBrush}"
                   AutomationProperties.Name="Unlock status"/>
        <Button x:Name="UnlockButton" Content="Unlock" Height="32" Margin="0,14,0,0"
                IsDefault="True" Click="OnUnlock"
                Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"
                ToolTip="Unlock MuseDesktop (Enter)"/>
        <Button x:Name="LeaveButton" Content="Stay locked" Height="28" Margin="0,8,0,0"
                IsCancel="True" Click="OnLeave"
                ToolTip="Close this window without unlocking"/>
    </StackPanel>
</Window>
