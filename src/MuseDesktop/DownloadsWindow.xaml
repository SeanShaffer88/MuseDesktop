<Window x:Class="MuseDesktop.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloads"
        Width="620" Height="560" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Active downloads (S2 #13) on top -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Active downloads" Style="{StaticResource Section}"/>
            <ListBox x:Name="ActiveList" Height="104" Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource HairlineBrush}"
                     SelectionChanged="OnActiveSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Active downloads">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,3">
                            <TextBlock Text="{Binding FileName}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="PauseButton" Content="Pause" Width="76" Height="26" Click="OnPauseDownload"/>
                <Button x:Name="ResumeButton" Content="Resume" Width="76" Height="26" Margin="8,0,0,0" Click="OnResumeDownload"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="76" Height="26" Margin="8,0,0,0" Click="OnCancelDownload"/>
                <Button x:Name="RetryButton" Content="Retry" Width="76" Height="26" Margin="8,0,0,0" Click="OnRetryDownload"
                        ToolTip="Re-download a file that failed during this session"/>
                <TextBlock x:Name="ActiveNote" Style="{StaticResource Note}" Margin="10,4,0,0"
                           Text="Nothing is downloading right now."/>
            </StackPanel>
        </StackPanel>

        <!-- History controls + list -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="History" Style="{StaticResource Section}" DockPanel.Dock="Top"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox x:Name="SearchText" Width="180" Height="24" VerticalContentAlignment="Center"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource HairlineBrush}" TextChanged="OnSearchOrFilterChanged"
                         ToolTip="Search by file name" AutomationProperties.Name="Search downloads"/>
                <ComboBox x:Name="StateFilterCombo" Width="110" Margin="8,0,0,0" SelectionChanged="OnSearchOrFilterChanged"
                          ToolTip="Show all, completed only, or failed only" AutomationProperties.Name="Filter by state">
                    <ComboBoxItem Content="All" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Completed" Tag="Completed"/>
                    <ComboBoxItem Content="Failed" Tag="Failed"/>
                </ComboBox>
                <ComboBox x:Name="SortCombo" Width="120" Margin="8,0,0,0" SelectionChanged="OnSearchOrFilterChanged"
                          ToolTip="Sort the history" AutomationProperties.Name="Sort downloads">
                    <ComboBoxItem Content="Newest first" Tag="NewestFirst" IsSelected="True"/>
                    <ComboBoxItem Content="Largest first" Tag="LargestFirst"/>
                    <ComboBoxItem Content="Name A–Z" Tag="NameAscending"/>
                </ComboBox>
            </StackPanel>
            <ListBox x:Name="DownloadsList" Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource HairlineBrush}"
                     MouseDoubleClick="OnOpen" SelectionChanged="OnSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Download history">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,3">
                            <TextBlock Text="{Binding FileName}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Bottom: note + history actions -->
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="NoteText" Style="{StaticResource Note}"
                       Text="Files Muse downloaded for you, newest first. The list is kept on this PC only."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OpenButton" Content="Open" Width="76" Height="30" Click="OnOpen"
                        Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"/>
                <Button x:Name="FolderButton" Content="Show in folder" Width="104" Height="30" Margin="8,0,0,0" Click="OnShowInFolder"/>
                <Button x:Name="CopyPathButton" Content="Copy path" Width="84" Height="30" Margin="8,0,0,0" Click="OnCopyPath"/>
                <Button x:Name="OpenWithButton" Content="Open with…" Width="92" Height="30" Margin="8,0,0,0" Click="OnOpenWith"/>
                <Button x:Name="DeleteFileButton" Content="Delete file" Width="86" Height="30" Margin="8,0,0,0" Click="OnDeleteFile"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Clear history" Width="100" Height="30" Click="OnClear"/>
                <Button Content="Close" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
