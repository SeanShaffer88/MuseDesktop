<Window x:Class="MuseDesktop.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MuseDesktop"
        Title="{local:Loc downloads}"
        Width="620" Height="680" MinWidth="460" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Active downloads (S2 #13) on top -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{local:Loc active_downloads}" Style="{StaticResource Section}"/>
            <ListBox x:Name="ActiveList" Height="104" Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource HairlineBrush}"
                     SelectionChanged="OnActiveSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.Name="{local:Loc active_downloads}" KeyboardNavigation.TabIndex="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,3">
                            <TextBlock Text="{Binding FileName}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="PauseButton" Content="{local:Loc pause}" Width="76" Height="26" Click="OnPauseDownload" KeyboardNavigation.TabIndex="3"/>
                <Button x:Name="ResumeButton" Content="{local:Loc resume}" Width="76" Height="26" Margin="8,0,0,0" Click="OnResumeDownload" KeyboardNavigation.TabIndex="4"/>
                <Button x:Name="CancelButton" Content="{local:Loc cancel}" Width="76" Height="26" Margin="8,0,0,0" Click="OnCancelDownload" KeyboardNavigation.TabIndex="5"/>
                <Button x:Name="RetryButton" Content="{local:Loc retry}" Width="76" Height="26" Margin="8,0,0,0" Click="OnRetryDownload"
                        ToolTip="{local:Loc re_download_a_file_that_failed_during_this}" KeyboardNavigation.TabIndex="6"/>
                <TextBlock x:Name="ActiveNote" Style="{StaticResource Note}" Margin="10,4,0,0"
                           Text="{local:Loc nothing_is_downloading_right_now}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Button x:Name="PauseAllButton" Content="{local:Loc pause_all}" Width="82" Height="24" Click="OnPauseAll"
                        ToolTip="{local:Loc pr20.pause_every_download_that_can_currently_be_paused}" KeyboardNavigation.TabIndex="7"/>
                <Button x:Name="ResumeAllButton" Content="{local:Loc resume_all}" Width="82" Height="24" Margin="8,0,0,0" Click="OnResumeAll"
                        ToolTip="{local:Loc pr20.resume_every_paused_download_that_webview2_allows}" KeyboardNavigation.TabIndex="8"/>
            </StackPanel>
            <!-- Speed history (R4 #135): samples stay in memory, on this PC only -->
            <TextBlock x:Name="SpeedGraphLabel" Style="{StaticResource Note}" Margin="0,8,0,2"
                       Text="{local:Loc dl.speed_graph_plain}"/>
            <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                    Background="{StaticResource SurfaceBrush}">
                <Canvas x:Name="SpeedCanvas" Height="44" ClipToBounds="True">
                    <Polyline x:Name="SpeedPolyline" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"/>
                </Canvas>
            </Border>
        </StackPanel>

        <!-- History controls + list -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="{local:Loc history}" Style="{StaticResource Section}" DockPanel.Dock="Top"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox x:Name="SearchText" Width="180" Height="24" VerticalContentAlignment="Center"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource HairlineBrush}" TextChanged="OnSearchTextChanged"
                         ToolTip="{local:Loc search_by_file_name}" AutomationProperties.Name="{local:Loc search_downloads}" KeyboardNavigation.TabIndex="9"/>
                <ComboBox x:Name="StateFilterCombo" Width="110" Margin="8,0,0,0" SelectionChanged="OnSearchOrFilterChanged"
                          ToolTip="{local:Loc show_all_completed_only_or_failed_only}" AutomationProperties.Name="{local:Loc filter_by_state}" KeyboardNavigation.TabIndex="10">
                    <ComboBoxItem Content="{local:Loc all}" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="{local:Loc completed}" Tag="Completed"/>
                    <ComboBoxItem Content="{local:Loc dl.detail_failed}" Tag="Failed"/>
                </ComboBox>
                <ComboBox x:Name="SortCombo" Width="120" Margin="8,0,0,0" SelectionChanged="OnSearchOrFilterChanged"
                          ToolTip="{local:Loc sort_the_history}" AutomationProperties.Name="{local:Loc msg.sort_downloads}" KeyboardNavigation.TabIndex="11">
                    <ComboBoxItem Content="{local:Loc newest_first}" Tag="NewestFirst" IsSelected="True"/>
                    <ComboBoxItem Content="{local:Loc largest_first}" Tag="LargestFirst"/>
                    <ComboBoxItem Content="{local:Loc name_a_z}" Tag="NameAscending"/>
                </ComboBox>
            </StackPanel>
            <ListBox x:Name="DownloadsList" Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource HairlineBrush}"
                     MouseDoubleClick="OnOpen" SelectionChanged="OnSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.Name="{local:Loc download_history}" KeyboardNavigation.TabIndex="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,3">
                            <TextBlock Text="{Binding FileName}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Bottom: note + history actions -->
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="NoteText" Style="{StaticResource Note}"
                       Text="{local:Loc files_muse_downloaded_for_you_newest_first}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OpenButton" Content="{local:Loc open}" Width="76" Height="30" Click="OnOpen"
                        Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0" KeyboardNavigation.TabIndex="14"/>
                <Button x:Name="FolderButton" Content="{local:Loc show_in_folder}" Width="104" Height="30" Margin="8,0,0,0" Click="OnShowInFolder" KeyboardNavigation.TabIndex="15"/>
                <Button x:Name="CopyPathButton" Content="{local:Loc copy_path}" Width="84" Height="30" Margin="8,0,0,0" Click="OnCopyPath" KeyboardNavigation.TabIndex="16"/>
                <Button x:Name="OpenWithButton" Content="{local:Loc open_with}" Width="92" Height="30" Margin="8,0,0,0" Click="OnOpenWith" KeyboardNavigation.TabIndex="17"/>
                <Button x:Name="DeleteFileButton" Content="{local:Loc delete_file}" Width="86" Height="30" Margin="8,0,0,0" Click="OnDeleteFile" KeyboardNavigation.TabIndex="18"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="NoteButton" Content="{local:Loc note}" Width="76" Height="30" Click="OnEditNote"
                        ToolTip="{local:Loc attach_a_short_note_to_the_selected_history}" KeyboardNavigation.TabIndex="19"/>
                <Button x:Name="VerifyButton" Content="{local:Loc verify_sha_256}" Width="118" Height="30" Margin="8,0,0,0" Click="OnVerifyHash"
                        ToolTip="{local:Loc pr20.check_the_selected_file_against_a_pasted_sha_256_hash_select_agai}" KeyboardNavigation.TabIndex="20"/>
                <Button x:Name="SortButton" Content="{local:Loc sort}" Width="70" Height="30" Margin="8,0,0,0" Click="OnSortDownloads"
                        ToolTip="{local:Loc move_finished_downloads_into_subfolders_by}" KeyboardNavigation.TabIndex="21"/>
                <Button x:Name="UndoSortButton" Content="{local:Loc msg.undo_sort}" Width="84" Height="30" Margin="8,0,0,0" Click="OnUndoSort"
                        ToolTip="{local:Loc move_the_last_sort_s_or_archive_s_files}" KeyboardNavigation.TabIndex="22"/>
                <Button x:Name="ArchiveButton" Content="{local:Loc archive}" Width="84" Height="30" Margin="8,0,0,0" Click="OnArchiveDownloads"
                        ToolTip="{local:Loc move_finished_downloads_into_dated_folders}" KeyboardNavigation.TabIndex="23"/>
                <Button x:Name="AddLinksButton" Content="{local:Loc add_links}" Width="92" Height="30" Margin="8,0,0,0" Click="OnAddLinks"
                        ToolTip="{local:Loc paste_a_list_of_links_and_download_them_all}" KeyboardNavigation.TabIndex="24"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{local:Loc clear_history}" Width="100" Height="30" Click="OnClear" KeyboardNavigation.TabIndex="25"/>
                <Button Content="{local:Loc close}" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True" KeyboardNavigation.TabIndex="26"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>