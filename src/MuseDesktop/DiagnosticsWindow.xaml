<Window x:Class="MuseDesktop.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc diagnostics}"
        Width="680" Height="520" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" xmlns:local="clr-namespace:MuseDesktop">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,0,0,0"
                   Text="{local:Loc what_s_happening_under_the_hood_the}"/>

        <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="ExportBundleButton" Content="{local:Loc export_support_bundle}" Width="170" Height="30" Click="OnExportBundle" Visibility="Collapsed"
                        ToolTip="{local:Loc save_one_zip_with_this_report_the_redacted}" KeyboardNavigation.TabIndex="1"/>
                <Button x:Name="OpenLogButton" Content="{local:Loc open_today_s_log}" Width="130" Height="30" Margin="8,0,0,0" Click="OnOpenLog" Visibility="Collapsed"
                        ToolTip="{local:Loc open_the_log_file_itself_in_your_default}" KeyboardNavigation.TabIndex="2"/>
                <Button x:Name="CopyLastErrorButton" Content="{local:Loc copy_last_error}" Width="120" Height="30" Margin="8,0,0,0" Click="OnCopyLastError" Visibility="Collapsed"
                        ToolTip="{local:Loc copy_just_the_most_recent_error_line_from}" KeyboardNavigation.TabIndex="3"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <TextBlock x:Name="CopyNote" Style="{StaticResource Note}" Margin="0,4,10,0"/>
                <Button x:Name="RollbackButton" Width="230" Height="30" Click="OnRollback" Visibility="Collapsed"
                        ToolTip="{local:Loc run_the_previous_version_s_installer_kept}" KeyboardNavigation.TabIndex="4"/>
                <Button Content="{local:Loc copy_report}" Width="110" Height="30" Margin="8,0,0,0" Click="OnCopy"
                        ToolTip="{local:Loc copy_this_report_to_the_clipboard_it}" KeyboardNavigation.TabIndex="5"/>
                <Button Content="{local:Loc refresh}" Width="86" Height="30" Margin="8,0,0,0" Click="OnRefresh"
                        ToolTip="{local:Loc collect_the_figures_again}" KeyboardNavigation.TabIndex="6"/>
                <Button Content="{local:Loc close}" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True" KeyboardNavigation.TabIndex="7"/>
            </StackPanel>
        </StackPanel>

        <TextBox x:Name="ReportText" Margin="0,10,0,0" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource HairlineBrush}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 AutomationProperties.Name="{local:Loc diagnostics_report}" KeyboardNavigation.TabIndex="8"/>
    </DockPanel>
</Window>
