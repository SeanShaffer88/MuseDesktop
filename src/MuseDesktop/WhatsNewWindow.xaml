<Window x:Class="MuseDesktop.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc what_s_new}"
        Width="620" Height="500" MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" xmlns:local="clr-namespace:MuseDesktop">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <TextBlock DockPanel.Dock="Top" x:Name="HeadlineText" FontSize="15" FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="{local:Loc what_s_new_headline}"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <CheckBox x:Name="NeverShowCheck" Content="{local:Loc don_t_show_what_s_new_again}"
                      ToolTip="{local:Loc turns_off_this_window_for_future_versions}" KeyboardNavigation.TabIndex="1"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{local:Loc close}" Width="86" Height="30" IsCancel="True" Click="OnClose" KeyboardNavigation.TabIndex="2"/>
            </StackPanel>
        </StackPanel>
        <TextBox x:Name="BodyText" Margin="0,10,0,0" IsReadOnly="True"
                 FontSize="12.5"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource HairlineBrush}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="{local:Loc what_s_new_in_this_version}" KeyboardNavigation.TabIndex="3"/>
    </DockPanel>
</Window>
