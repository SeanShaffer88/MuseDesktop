<Window x:Class="MuseDesktop.SnippetTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MuseDesktop"
        Title="{local:Loc fill_in_the_blanks}"
        Width="520" MinWidth="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="Height"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="18,14,18,14">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap"/>
        <StackPanel x:Name="FieldsPanel"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="{local:Loc ok}" Width="86" Height="30" IsDefault="True" IsEnabled="False" Click="OnOk"
                    Background="{StaticResource AccentBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0" KeyboardNavigation.TabIndex="1"/>
            <Button x:Name="CancelButton" Content="{local:Loc cancel}" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True" KeyboardNavigation.TabIndex="2"/>
        </StackPanel>
    </StackPanel>
</Window>
