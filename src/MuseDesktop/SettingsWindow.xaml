<Window x:Class="MuseDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MuseDesktop"
        Title="MuseDesktop Settings"
        Width="480" Height="660" MinWidth="440" MinHeight="420" MaxHeight="1000"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <local:ProfileColorBrushConverter x:Key="ProfileColorBrush"/>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <!-- S6 #51: window-local styles must not lose the focus visual. -->
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Settings search (S5 #41): section-level filter + highlight. -->
        <StackPanel DockPanel.Dock="Top" Margin="18,12,18,0">
            <TextBlock Text="Search settings:" Margin="0,0,0,4"/>
            <TextBox x:Name="SettingsSearchText" TextChanged="OnSearchTextChanged"
                     ToolTip="Type to jump to a setting — matching sections stay visible and are highlighted; the rest hide while you search"/>
            <TextBlock x:Name="SearchSummary" Style="{StaticResource Note}"/>
        </StackPanel>

        <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnSettingsScrolled">
            <StackPanel x:Name="SectionsPanel" Margin="18,6,18,16">
                <StackPanel x:Name="SectionBehavior">
                    <TextBlock x:Name="HeaderBehavior" Text="Behavior" Style="{StaticResource SectionHeader}"/>
                    <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows"
                              ToolTip="Launch MuseDesktop when you sign in to Windows (the usual per-user Run entry)"/>
                    <CheckBox x:Name="StartMinimizedCheck" Content="When starting with Windows, open in the tray (not on screen)"
                              ToolTip="Only affects the sign-in launch: on = MuseDesktop waits in the tray; off = the window opens like a normal launch. Double-clicking the app always opens the window"/>
                    <CheckBox x:Name="CloseToTrayCheck" Content="Close window to tray (instead of quitting)"
                              ToolTip="The X button hides the window; Exit lives on the tray menu"/>
                    <CheckBox x:Name="SuspendInTrayCheck" Content="Save memory while hidden in the tray"
                              ToolTip="After the time below, the web view is suspended until you come back. Suspend never happens during a download, and stays out of the way after the microphone has been used (a voice session may be live)"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="Suspend after hidden for:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SuspendTimeoutCombo" Width="130"
                                  ToolTip="How long the window may sit hidden in the tray before the web view suspends"/>
                    </StackPanel>
                    <CheckBox x:Name="CheckUpdatesCheck" Content="Check for updates when the app starts"
                              ToolTip="One silent request to GitHub Releases per launch; failures are ignored"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="Check automatically:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="UpdateFrequencyCombo" Width="210"
                                  ToolTip="How often the automatic check runs. The ⋯ menu's Check for updates always works, whatever this says"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="Release channel:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="UpdateChannelCombo" Width="210"
                                  ToolTip="Stable releases only, or also pre-releases (test builds). Stable users are never offered a pre-release"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Pre-releases are unfinished test builds: they can contain bugs and half-finished features. Only choose the pre-release channel if you want to help test. Switching back to Stable offers you the next stable release — it never downgrades you on its own."/>
                    <CheckBox x:Name="ShowWhatsNewCheck" Content="Show “What's New” the first time a new version runs"
                              ToolTip="After an update, the new version's release notes open once. The window itself also has a “don't show again” box"/>
                    <TextBlock x:Name="UpdateSnoozeNote" Style="{StaticResource Note}"/>
                    <Button x:Name="StopSnoozeButton" Content="Stop snoozing update reminders" Width="210" HorizontalAlignment="Left"
                            Margin="0,4,0,0" Click="OnStopUpdateSnooze" Visibility="Collapsed"
                            ToolTip="Cancel the snooze set from the update window (Remind me tomorrow / next week)"/>
                    <!-- S11 #99: musedesktop:// links. The installer
                         registers the scheme; this toggle keeps the
                         registration in line with it (and is how
                         portable installs register). The status line
                         reports the ACTUAL registration — including
                         when another app owns the scheme, which is
                         never overwritten. -->
                    <TextBlock Style="{StaticResource Note}" Margin="0,14,0,2"
                               Text="Links — links that start with musedesktop:// can open MuseDesktop at a fixed set of places (the window, Home, Settings, Downloads, Help, or a profile). A link can never carry a web address or open anything else, and while the app is locked, links wait until you unlock."/>
                    <CheckBox x:Name="ProtocolLinksCheck" Content="Let musedesktop:// links open MuseDesktop" Margin="0,2,0,0"
                              ToolTip="Register MuseDesktop as the handler for musedesktop:// links for your Windows user account"/>
                    <TextBlock x:Name="ProtocolStatus" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
                    <Button Content="Run the setup wizard again…" Width="210" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="OnRunSetupWizard"
                            ToolTip="Re-run the one-screen first-run setup (close-to-tray, start with Windows, downloads folder, update checks)"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Changes apply when you choose OK. Start-with-Windows writes the usual per-user Run entry; nothing here phones home beyond the update check you control."/>
                </StackPanel>

                <StackPanel x:Name="SectionTray">
                    <TextBlock x:Name="HeaderTray" Text="Tray &amp; notifications" Style="{StaticResource SectionHeader}"/>
                    <CheckBox x:Name="TraySingleClickCheck" Content="Single-click the tray icon to reopen (instead of double-click)"
                              ToolTip="On: one click on the tray icon brings the window back. Off: double-click, as always"/>
                    <CheckBox x:Name="FlashOnAttentionCheck" Content="Flash the taskbar button when Muse needs attention while I'm away"
                              ToolTip="When Muse's title shows an unread count (like (2) Muse) and you're not looking at the window, the taskbar button flashes a few times — it never steals focus. Off by default"/>
                    <CheckBox x:Name="QuietHoursCheck" Content="Quiet hours: keep MuseDesktop's balloons and flashes silent"
                              ToolTip="During quiet hours MuseDesktop shows no tray balloons and no taskbar flash (the suppression is written to the log, never silent). Your Windows Do Not Disturb setting is always respected too"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="Quiet from:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="QuietStartCombo" Width="90"
                                  ToolTip="Quiet hours begin (on the hour)"/>
                        <TextBlock Text="to:" VerticalAlignment="Center" Margin="12,0,8,0"/>
                        <ComboBox x:Name="QuietEndCombo" Width="90"
                                  ToolTip="Quiet hours end (on the hour) — earlier than the start is fine; the window wraps midnight"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Muse's own in-page notifications are governed by Windows and Muse, not by these settings. The tray icon also shows your active profile's accent color as a small dot, and an unread-count badge when Muse's title provides one."/>
                </StackPanel>

                <StackPanel x:Name="SectionProfiles">
                    <TextBlock x:Name="HeaderProfiles" Text="Account profiles" Style="{StaticResource SectionHeader}"/>
                    <ComboBox x:Name="ProfileCombo" SelectionChanged="OnProfileSelectionChanged"
                              ToolTip="Sign-in profiles — each keeps its own Muse session">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding DisplayColor, Converter={StaticResource ProfileColorBrush}}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,2"
                               Text="Name (rename the selected profile):"/>
                    <TextBox x:Name="ProfileNameText" LostFocus="OnProfileNameLostFocus"
                             ToolTip="The selected profile's name, shown in menus and the tray"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="Accent color:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ProfileColorCombo" Width="140" SelectionChanged="OnProfileColorChanged"
                                  ToolTip="A small color dot next to this profile's name in menus, the tray, and here"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="Avatar icon:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ProfileGlyphCombo" Width="140" SelectionChanged="OnProfileGlyphChanged"
                                  ToolTip="A small symbol shown before this profile's name in the switcher, menus, and the tray — and stamped onto its desktop-shortcut icon"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="Group:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ProfileGroupCombo" Width="140" SelectionChanged="OnProfileGroupChanged"
                                  ToolTip="Groups gather profiles under one heading in the switcher and menus — handy when you have many profiles"/>
                        <Button x:Name="DeleteGroupButton" Content="Delete group" Width="96" Margin="8,0,0,0" Click="OnDeleteProfileGroup"
                                ToolTip="Deletes the selected group; its profiles stay, just ungrouped"/>
                    </StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,6,0,0">
                        <Button x:Name="AddGroupButton" DockPanel.Dock="Right" Content="Add group" Width="84" Margin="8,0,0,0"
                                Click="OnAddProfileGroup"/>
                        <TextBox x:Name="NewGroupText" ToolTip="Name for a new profile group, e.g. Clients"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                               Text="When this profile starts:"/>
                    <RadioButton x:Name="ProfileStartLastRadio" GroupName="ProfileStartPage"
                                 Content="Reopen the page it was last on" Checked="OnProfileStartModeChanged"
                                 ToolTip="The profile picks up where it left off (the long-standing behavior)"/>
                    <RadioButton x:Name="ProfileStartHomeRadio" GroupName="ProfileStartPage"
                                 Content="Start at the Muse home page" Checked="OnProfileStartModeChanged"
                                 ToolTip="This profile always opens at Muse's home page"/>
                    <RadioButton x:Name="ProfileStartCustomRadio" GroupName="ProfileStartPage"
                                 Content="Start at a specific Muse page:" Checked="OnProfileStartModeChanged"
                                 ToolTip="This profile opens at the muse.ai page below — validated before use; an address MuseDesktop can't open falls back to the home page"/>
                    <TextBox x:Name="ProfileCustomUrlText" Margin="18,4,0,0" LostFocus="OnProfileCustomUrlLostFocus"
                             ToolTip="A muse.ai page address, e.g. https://muse.ai/chat/… — only Muse pages are accepted"/>
                    <TextBlock x:Name="ProfileCustomUrlNote" Style="{StaticResource Note}" Margin="18,2,0,0"/>
                    <CheckBox x:Name="ProfileZoomCheck" Content="Use a custom zoom for this profile"
                              Checked="OnProfileZoomChanged" Unchecked="OnProfileZoomChanged"
                              ToolTip="On: this profile zooms independently. Off: it uses the shared default zoom below. Zooming in the app updates the custom zoom while it's on"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="Profile zoom:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ProfileZoomCombo" Width="90" SelectionChanged="OnProfileZoomComboChanged"
                                  ToolTip="This profile's own zoom (used while the custom-zoom box above is ticked)"/>
                    </StackPanel>
                    <TextBlock x:Name="ProfileDataText" Style="{StaticResource Note}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="Data size cap:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ProfileDataCapCombo" Width="150" SelectionChanged="OnProfileDataCapChanged"
                                  ToolTip="Optional cap on this profile's data folder. When the folder passes the cap, only disposable caches are emptied (oldest first) — cookies and sign-ins are never touched"/>
                    </StackPanel>
                    <TextBlock x:Name="ProfileCapNote" Style="{StaticResource Note}"/>
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,2"
                               Text="Downloads folder for this profile (optional — overrides the shared folder below):"/>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="ClearProfileFolderButton" DockPanel.Dock="Right" Content="Clear" Width="56" Margin="8,0,0,0"
                                Click="OnClearProfileDownloadsFolder"
                                ToolTip="Remove this profile's downloads-folder override"/>
                        <Button x:Name="BrowseProfileFolderButton" DockPanel.Dock="Right" Content="Browse…" Width="76" Margin="8,0,0,0"
                                Click="OnBrowseProfileDownloadsFolder"/>
                        <TextBox x:Name="ProfileDownloadsFolderText" IsReadOnly="True"
                                 ToolTip="This profile's downloads land here; empty uses the shared Downloads folder"/>
                    </DockPanel>
                    <CheckBox x:Name="ProfileArchivedCheck" Content="Archive this profile (hide it from switchers; its data stays on this PC)"
                              Margin="0,10,0,0" Checked="OnProfileArchivedChanged" Unchecked="OnProfileArchivedChanged"
                              ToolTip="Archived profiles disappear from the switcher, menus, and shortcut keys, but nothing is deleted and a desktop shortcut for the profile still opens it. Untick to restore. The profile you're using can't be archived"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="Profile PIN:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ProfilePinStatus" VerticalAlignment="Center"/>
                        <Button x:Name="SetProfilePinButton" Content="Set PIN…" Width="84" Margin="8,0,0,0" Click="OnSetProfilePin"
                                ToolTip="Ask for a PIN whenever MuseDesktop launches with this profile. The app password (if set) is still asked first. A PIN is a privacy screen, not encryption"/>
                        <Button x:Name="RemoveProfilePinButton" Content="Remove PIN" Width="96" Margin="8,0,0,0" Click="OnRemoveProfilePin"
                                ToolTip="Remove this profile's PIN (asks for the current PIN first)"/>
                    </StackPanel>
                    <CheckBox x:Name="ProfileScheduleCheck" Content="Switch to this profile on a schedule:"
                              Margin="0,10,0,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged"
                              ToolTip="During the hours below, MuseDesktop offers to switch to this profile (or switches on its own, if you tick the box further down). Switching by hand always wins"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,4,0,0">
                        <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="ProfileScheduleStartText" Width="56" LostFocus="OnProfileScheduleChanged"
                                 ToolTip="Start time, 24-hour clock — e.g. 09:00"/>
                        <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0,6,0"/>
                        <TextBox x:Name="ProfileScheduleEndText" Width="56" LostFocus="OnProfileScheduleChanged"
                                 ToolTip="End time, 24-hour clock — e.g. 17:00. An end earlier than the start runs past midnight"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="18,4,0,0">
                        <CheckBox x:Name="SchedMon" Content="Mon" Margin="0,0,8,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged"/>
                        <CheckBox x:Name="SchedTue" Content="Tue" Margin="0,0,8,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged"/>
                        <CheckBox x:Name="SchedWed" Content="Wed" Margin="0,0,8,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged"/>
                        <CheckBox x:Name="SchedThu" Content="Thu" Margin="0,0,8,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged"/>
                        <CheckBox x:Name="SchedFri" Content="Fri" Margin="0,0,8,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged"/>
                        <CheckBox x:Name="SchedSat" Content="Sat" Margin="0,0,8,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged"/>
                        <CheckBox x:Name="SchedSun" Content="Sun" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="ProfileScheduleText" Style="{StaticResource Note}" Margin="18,2,0,0"/>
                    <CheckBox x:Name="ScheduleAutoCheck" Content="Switch automatically when a schedule starts (don't ask first)"
                              Margin="18,4,0,0" Checked="OnScheduleAutoChanged" Unchecked="OnScheduleAutoChanged"
                              ToolTip="Off (the default): when a scheduled time arrives, MuseDesktop asks before switching. On: it switches right away. Either way, a profile you picked by hand is left alone until its time is up"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="RefreshProfileHealthButton" Content="Profile health…" Width="110" Click="OnRefreshProfileHealth"
                                ToolTip="Counts only: this profile's data size, disposable cache, cookie count, and last backup. Nothing about which sites or pages"/>
                        <Button x:Name="ClearProfileUsageButton" Content="Clear usage counts" Width="140" Margin="8,0,0,0" Click="OnClearProfileUsage"
                                ToolTip="Deletes the launch counts for every profile. They are stored only on this PC and never sent anywhere"/>
                    </StackPanel>
                    <TextBlock x:Name="ProfileHealthText" Style="{StaticResource Note}"/>
                    <TextBlock x:Name="ProfileUsageText" Style="{StaticResource Note}" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="SwitchProfileButton" Content="Switch to this profile" Width="150" Click="OnSwitchProfile"
                                ToolTip="Restarts MuseDesktop signed in with the selected profile"/>
                        <Button x:Name="RemoveProfileButton" Content="Remove" Width="76" Margin="8,0,0,0" Click="OnRemoveProfile"
                                ToolTip="Removes the profile; its local sign-in data is deleted when you choose OK"/>
                        <Button x:Name="CreateShortcutButton" Content="Create desktop shortcut" Width="164" Margin="8,0,0,0" Click="OnCreateProfileShortcut"
                                ToolTip="Puts a shortcut on the Desktop that opens MuseDesktop with this profile"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="CloneProfileButton" Content="Clone profile" Width="110" Click="OnCloneProfile"
                                ToolTip="A new profile with this one's settings and appearance. Sign-in data is never copied — the clone starts signed out"/>
                        <Button x:Name="ExportProfileButton" Content="Export profile…" Width="116" Margin="8,0,0,0" Click="OnExportProfile"
                                ToolTip="Save this profile's settings and appearance as a small bundle file you can import on another PC"/>
                        <Button x:Name="ImportProfileButton" Content="Import profile…" Width="116" Margin="8,0,0,0" Click="OnImportProfile"
                                ToolTip="Add a profile from a bundle file. Importing always creates a new profile — it never overwrites one"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Cloning and bundles carry settings and appearance only — never sign-in data, cookies, the profile PIN, its schedule, or usage counts."/>
                    <TextBlock x:Name="ProfileNote" Style="{StaticResource Note}"/>
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,2"
                               Text="New profile — optionally copy settings (start page, downloads folder, zoom, color) from an existing one. Sign-ins are never copied:"/>
                    <ComboBox x:Name="CopyFromCombo" SelectionChanged="OnCopyFromChanged"
                              ToolTip="Copy the new profile's settings from this profile; its sign-in is never copied"/>
                    <DockPanel LastChildFill="True" Margin="0,6,0,0">
                        <Button x:Name="AddProfileButton" DockPanel.Dock="Right" Content="Add" Width="76" Margin="8,0,0,0"
                                Click="OnAddProfile"/>
                        <TextBox x:Name="NewProfileNameText" ToolTip="Name for a new profile, e.g. Work"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="Or start from a template:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ProfileTemplateCombo" Width="180"
                                  ToolTip="Starter looks: Work (blue flag, home page), Personal (purple heart), Reading (orange moon, 125% zoom)"/>
                        <Button x:Name="AddFromTemplateButton" Content="Add from template" Width="140" Margin="8,0,0,0" Click="OnAddFromTemplate"
                                ToolTip="Creates a profile with the template's name, color, icon, and start page — change anything about it afterwards"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Each profile is a separate Muse sign-in (its own cookies and data on this PC). Switching restarts the app immediately, discarding other unsaved changes in this window. You can't remove the profile you're currently using."/>
                </StackPanel>

                <StackPanel x:Name="SectionWorkspaces">
                    <TextBlock x:Name="HeaderWorkspaces" Text="Workspaces &amp; sessions" Style="{StaticResource SectionHeader}"/>
                    <ComboBox x:Name="WorkspaceCombo" SelectionChanged="OnWorkspaceSelectionChanged"
                              ToolTip="Your saved workspaces — named sets of windows you can re-apply from the ⋯ menu, the tray, or Ctrl+K"/>
                    <TextBox x:Name="WorkspaceNameText" LostFocus="OnWorkspaceNameLostFocus" Margin="0,6,0,0"
                             ToolTip="The workspace's name, as shown in menus"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="Icon:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="WorkspaceGlyphCombo" Width="140" SelectionChanged="OnWorkspaceGlyphChanged"
                                  ToolTip="A symbol shown next to the workspace's name in the tray menu and the command palette"/>
                        <TextBlock Text="Accent override:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox x:Name="WorkspaceAccentCombo" Width="140" SelectionChanged="OnWorkspaceAccentChanged"
                                  ToolTip="While this workspace is applied, MuseDesktop's accent uses this color instead of the Appearance accent. The saved Appearance accent itself is never changed"/>
                    </StackPanel>
                    <CheckBox x:Name="WorkspaceStartupCheck" Content="Open this workspace when MuseDesktop starts" Margin="0,10,0,0"
                              Click="OnWorkspaceStartupChanged"
                              ToolTip="At launch, this workspace's windows open instead of the single default window"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="WorkspaceApplyButton" Content="Apply now" Width="92" Click="OnApplyWorkspace"
                                ToolTip="Apply this workspace right away (Settings closes, like a profile switch)"/>
                        <Button x:Name="WorkspaceDuplicateButton" Content="Duplicate" Width="84" Margin="8,0,0,0" Click="OnDuplicateWorkspace"
                                ToolTip="Copy this workspace — its windows, icon, and accent — under a new name"/>
                        <Button x:Name="WorkspaceDeleteButton" Content="Delete" Width="76" Margin="8,0,0,0" Click="OnDeleteWorkspace"
                                ToolTip="Deletes the saved layout when you choose OK. No window closes and no data is touched — only the saved layout goes away"/>
                    </StackPanel>
                    <TextBlock x:Name="WorkspaceNote" Style="{StaticResource Note}" Margin="0,8,0,0"/>
                    <CheckBox x:Name="AutoSaveSessionCheck" Margin="0,12,0,0"
                              Content="Pick up where I left off — reopen the windows I had open"
                              ToolTip="When MuseDesktop starts, the windows from the last session come back. Off by default."/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="A workspace remembers which profile each window belongs to, where it sits, and which Muse section it shows (chat, projects, …) — never the full page address, and never a query string. After a crash, MuseDesktop offers your previous windows once, whether or not the box above is ticked."/>
                </StackPanel>

                <StackPanel x:Name="SectionAppearance">
                    <TextBlock x:Name="HeaderAppearance" Text="Appearance &amp; toolbar" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Shell theme:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ThemeCombo" Width="170"
                                  ToolTip="Dark is the family black/red identity; Light is a light shell; Follow Windows matches your Windows app theme. Muse's page itself is never restyled"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock Text="Accent color:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="AccentCombo" Width="170"
                                  ToolTip="Colors MuseDesktop's own highlights (section titles, buttons). Each accent is checked for readable contrast on both shell themes. This is separate from profile colors"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock Text="Shell text size:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TextScaleCombo" Width="170"
                                  ToolTip="Scales MuseDesktop's own text (toolbar, menus, Settings) — separate from page zoom. The tray menu is drawn by Windows and keeps its system size"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Theme, accent, and text size restyle MuseDesktop's own windows only — never the Muse page."/>
                    <TextBlock Style="{StaticResource Note}" Margin="0,10,0,2"
                               Text="Toolbar buttons — tick to show, select then move with ↑ / ↓ (the ⋯ menu is always there, last):"/>
                    <ListBox x:Name="ToolbarList" Height="148"
                             Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource HairlineBrush}"
                             ToolTip="The main window's toolbar buttons, in order, grouped as they appear (Back…Home on the left, zoom…browser on the right)"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="↑ Move up" Width="92" Click="OnToolbarMoveUp"/>
                        <Button Content="↓ Move down" Width="98" Margin="8,0,0,0" Click="OnToolbarMoveDown"/>
                        <Button Content="Reset layout" Width="104" Margin="8,0,0,0" Click="OnToolbarReset"
                                ToolTip="Back to the standard toolbar: every button shown, in the original order"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Back always stays — the toolbar must always offer navigation."/>
                </StackPanel>

                <StackPanel x:Name="SectionZoom">
                    <TextBlock x:Name="HeaderZoom" Text="Zoom" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Default zoom:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ZoomCombo" Width="90"
                                  ToolTip="The shared default zoom — applies at OK and is where the toolbar zoom starts next launch"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Applies immediately at OK and is where the toolbar zoom starts next launch."/>
                    <CheckBox x:Name="ExtendedZoomCheck" Content="Extended zoom range (25%–500%)"
                              Checked="OnExtendedZoomChanged" Unchecked="OnExtendedZoomChanged"
                              ToolTip="Widens the zoom range and its steps for low-vision use: 25% to 500% instead of the standard 50% to 200%"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Zoom steps get finer near 100% either way; the extended range adds the extremes."/>
                </StackPanel>

                <!-- Keyboard & accessibility (v0.10.0, S6) -->
                <StackPanel x:Name="SectionAccessibility">
                    <TextBlock x:Name="HeaderAccessibility" Text="Keyboard &amp; accessibility" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Reduce motion:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ReduceMotionCombo" Width="190"
                                  ToolTip="Follow Windows reads the Windows animation-effects setting; On keeps the shell's effects off regardless">
                            <ComboBoxItem Content="Follow Windows"/>
                            <ComboBoxItem Content="On (reduce motion)"/>
                            <ComboBoxItem Content="Off (full motion)"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="MuseDesktop's shell has almost no animation of its own; this setting quiets the one effect it does have — the taskbar attention flash. Animation inside the Muse page follows Windows' own setting."/>
                    <TextBlock Style="{StaticResource Note}" Margin="0,10,0,2"
                               Text="Changeable shortcuts — click a key button, then press the new combination (it must include Ctrl or Alt). Reset puts one key back to its default:"/>
                    <StackPanel x:Name="ShortcutRows"/>
                    <TextBlock x:Name="ShortcutStatus" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="All shortcuts…" Width="130" Click="OnOpenShortcutsList"
                                ToolTip="Open the searchable list of every shortcut (Ctrl+/)"/>
                        <Button Content="Reset all keys" Width="120" Margin="8,0,0,0" Click="OnResetAllShortcuts"
                                ToolTip="Put every changed shortcut back to its default"/>
                    </StackPanel>
                    <!-- S11 #96: the global show/hide hotkey. It lives
                         OUTSIDE the in-app shortcut list above on
                         purpose: it is registered with Windows itself
                         and works while other apps have focus; Core's
                         GlobalHotkey checks the two systems against
                         each other so they can never share a key. -->
                    <TextBlock Style="{StaticResource Note}" Margin="0,14,0,2"
                               Text="Global hotkey — registered with Windows, so it works while any app has focus. Click the key button, then press the new combination (it must include Ctrl or Alt):"/>
                    <CheckBox x:Name="GlobalHotkeyCheck" Content="Show or hide MuseDesktop with a global hotkey" Margin="0,2,0,0"
                              ToolTip="Press the combination anywhere to bring MuseDesktop forward; press it again to hide it to the tray"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="GlobalHotkeyButton" MinWidth="170" Click="OnCaptureGlobalHotkey"
                                ToolTip="The current global hotkey combination — click, then press a new one"/>
                        <Button Content="Reset" Width="80" Margin="8,0,0,0" Click="OnResetGlobalHotkey"
                                ToolTip="Put the global hotkey back to the default, Ctrl+Alt+M"/>
                    </StackPanel>
                    <TextBlock x:Name="GlobalHotkeyStatus" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="The default is Ctrl+Alt+M. If another app already uses the combination, registration fails and the status line above says so — pick a different one. While the app is locked, the hotkey only ever shows the lock screen."/>
                </StackPanel>

                <StackPanel x:Name="SectionDownloads">
                    <TextBlock x:Name="HeaderDownloads" Text="Downloads" Style="{StaticResource SectionHeader}"/>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="BrowseFolderButton" DockPanel.Dock="Right" Content="Browse…" Width="76" Margin="8,0,0,0"
                                Click="OnBrowseDownloadsFolder"/>
                        <TextBox x:Name="DownloadsFolderText" IsReadOnly="True"
                                 ToolTip="Where downloads are saved"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Empty means your Windows Downloads folder. Changing it does not move files already downloaded."/>
                    <CheckBox x:Name="AskWhereToSaveCheck" Content="Ask where to save each download"
                              ToolTip="Shows a Save-As dialog for every file"/>
                    <CheckBox x:Name="NotifyDownloadCompleteCheck" Content="Tell me when a download finishes while the window is hidden"
                              ToolTip="Shows a tray balloon naming the file. Off by default; never makes a sound"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="If the file already exists:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CollisionPolicyCombo" Width="210"
                                  ToolTip="Save under a new name automatically, or ask where to save that file"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="Keep download history:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="HistoryCapCombo" Width="120"
                                  ToolTip="How many finished downloads the Downloads window remembers"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="History keeps names, sizes, dates, and paths only — never the addresses files came from. Failed downloads are listed too."/>

                    <TextBlock Text="Sorting, scheduling &amp; more (v1.4.0):" Margin="0,14,0,4" FontWeight="SemiBold"/>
                    <CheckBox x:Name="AutoSortDownloadsCheck" Content="Sort each finished download into a subfolder automatically"
                              ToolTip="Uses your rules below first, then the built-in file-type folders. The Downloads window's Sort does the same on demand, with a preview and Undo"/>
                    <CheckBox x:Name="SortCategoriesCheck" Content="Use the built-in file-type folders (Images, Documents, Archives, Audio, Video, Programs, Other)"
                              ToolTip="Applies when no custom rule matches a file"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Custom sort rules — one per line: extensions or a *pattern*, then =, then the subfolder. Example: pdf, docx = Documents  ·  *invoice* = Finance"/>
                    <TextBox x:Name="SortRulesText" Height="58" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Custom download sort rules, tried in order before the file-type folders"
                             AutomationProperties.Name="Custom sort rules"/>
                    <TextBlock x:Name="SortRulesNote" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="Bandwidth limit (KB/s, 0 = no limit):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="BandwidthLimitText" Width="80"
                                 ToolTip="A cap on all downloads together. WebView2 can't slow a single transfer, so MuseDesktop pauses the newest download while the total is over the limit and resumes it when there's room"/>
                    </StackPanel>
                    <CheckBox x:Name="DownloadQuietCheck" Content="Hold large downloads during quiet hours"
                              ToolTip="Files known to be large wait until the window ends, then start by themselves. Small files — and files whose size isn't known yet — still download"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="DownloadQuietStartText" Width="56"
                                 ToolTip="Quiet-hours start, 24-hour clock (e.g. 09:00)"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox x:Name="DownloadQuietEndText" Width="56"
                                 ToolTip="Quiet-hours end, 24-hour clock (e.g. 17:00). A window can run past midnight"/>
                        <TextBlock Text="Large means (MB):" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox x:Name="DownloadQuietLargeText" Width="64"
                                 ToolTip="Files at least this big wait out the quiet hours; 0 holds every download"/>
                    </StackPanel>
                    <CheckBox x:Name="DuplicateGuardCheck" Content="Warn when a download looks like one already downloaded"
                              ToolTip="Same file name (and size, when known) as a finished download whose file is still on disk. Keeping both saves the new one under a fresh name"/>
                    <CheckBox x:Name="AutoRetryCheck" Content="Retry failed downloads automatically"
                              ToolTip="Network and server failures only, with a growing wait between tries. Disk, permission, and cancelled downloads never retry"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="Automatic retries per download:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="RetryAttemptsCombo" Width="70"
                                  ToolTip="How many times a failed download retries itself (1 to 5)"/>
                    </StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Browse…" Width="76" Margin="8,0,0,0"
                                Click="OnBrowseArchiveFolder"/>
                        <TextBox x:Name="ArchiveFolderText" IsReadOnly="True"
                                 ToolTip="Where archived downloads go; empty uses an Archive folder inside the downloads folder"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Archive folder — the Downloads window's Archive button moves finished downloads into dated subfolders here."/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="When sorting, archive downloads older than (days, 0 = only when I ask):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="ArchiveDaysText" Width="64"
                                 ToolTip="Finished downloads older than this go to the archive when Sort runs, instead of a type subfolder"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="Download quota for the profile you're using (MB, 0 = no cap):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="ProfileQuotaText" Width="80"
                                 ToolTip="A soft cap on this profile's downloads folder: a heads-up at 80% and again at the cap. It never blocks a download and never deletes anything"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="The quota belongs to the profile you're using now — switch profiles to set theirs. It only ever warns."/>
                </StackPanel>

                <StackPanel x:Name="SectionData">
                    <TextBlock x:Name="HeaderData" Text="Data" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,0"
                               Text="Clearing browsing data (cookies, cache, site data) moved to Privacy &amp; security below, where you can choose exactly what to clear and for which profiles."/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Open data folder" Width="130" Click="OnOpenDataFolder"
                                ToolTip="Open the folder with settings, logs, and download history in File Explorer"/>
                        <Button Content="Backup guide…" Width="130" Margin="8,0,0,0" Click="OnBackupGuide"
                                ToolTip="Exactly what to copy to back up your sign-ins, and what an export does and doesn't cover"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Export settings…" Width="130" Click="OnExportSettings"
                                ToolTip="Save these settings to a file you can keep or move to another PC"/>
                        <Button Content="Import settings…" Width="130" Margin="8,0,0,0" Click="OnImportSettings"
                                ToolTip="Replace these settings with ones from an exported file"/>
                    </StackPanel>
                    <TextBlock x:Name="ImportNote" Style="{StaticResource Note}"
                               Text="Export saves the settings shown here (including profiles and per-profile start pages) as a small JSON file. Sign-ins themselves are not exported — those stay in each profile's own data."/>
                    <Button Content="Reset all settings to defaults…" Width="230" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Click="OnResetSettings"
                            ToolTip="Restores every preference to its default. Your current settings are exported to a backup file first; profiles, sign-ins, and downloads are not touched"/>
                    <TextBlock x:Name="ResetNote" Style="{StaticResource Note}"
                               Text="Reset restores preferences only — profiles, sign-ins, last pages, and downloaded files stay exactly as they are. A backup of your current settings is saved first, so Import can undo it."/>
                    <Button Content="Reset MuseDesktop…" Width="230" HorizontalAlignment="Left"
                            Margin="0,12,0,0" Click="OnOpenResetWizard"
                            ToolTip="The guided reset: backup first, then choose — reset settings, clear site data for all profiles, or both — each step explained"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Won't start, or won't sign in? The guided reset walks through the fix step by step — a backup of your current settings is written before anything changes."/>
                    <TextBlock Text="Automatic backups:" Margin="0,12,0,4" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,0"
                               Text="MuseDesktop keeps the five most recent backups of your settings and your downloads history — at most one new automatic backup per day, plus whenever you choose Back up now. Restoring settings goes through the same checks as Import."/>
                    <Button Content="Back up now" Width="130" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Click="OnBackupNow"
                            ToolTip="Write a fresh backup of settings and downloads history right now"/>
                    <StackPanel x:Name="BackupRows" Margin="0,6,0,0"/>
                    <TextBlock x:Name="BackupNote" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="PortableNote" Style="{StaticResource Note}" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel x:Name="SectionPrivacy">
                    <TextBlock x:Name="HeaderPrivacy" Text="Privacy &amp; security" Style="{StaticResource SectionHeader}"/>

                    <CheckBox x:Name="PasswordAutosaveCheck" Content="Let Muse save passwords in the web view"
                              ToolTip="WebView2's own password save, on by default. Turning this off stops NEW passwords being saved; ones already saved still fill until you clear site data"/>
                    <CheckBox x:Name="GeneralAutofillCheck" Content="Let the web view remember and refill form entries"
                              ToolTip="WebView2's general autofill for ordinary form fields, on by default"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="These are the web engine's features, shared by every window in the profile. They apply to the profile MuseDesktop is currently running and take effect as soon as you choose OK."/>

                    <TextBlock Text="Clear browsing data:" Margin="0,12,0,4" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ClearChoiceCombo" Width="140" SelectionChanged="OnClearChoiceChanged"
                                  ToolTip="What to clear: cookies only, cache only, or all site data"/>
                        <ComboBox x:Name="ClearScopeCombo" Width="150" Margin="8,0,0,0" SelectionChanged="OnClearChoiceChanged"
                                  ToolTip="Clear just the profile you're using, or every profile on this PC"/>
                        <Button x:Name="ClearNowButton" Content="Clear…" Width="76" Margin="8,0,0,0" Click="OnClearDataGranular"
                                ToolTip="Clear the chosen data now (you'll be asked to confirm, with exactly what it does)"/>
                    </StackPanel>
                    <TextBlock x:Name="ClearPlanNote" Style="{StaticResource Note}"/>
                    <TextBlock x:Name="ClearResultNote" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>

                    <TextBlock Text="Permissions (profile MuseDesktop is currently running):" Margin="0,12,0,4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PermissionsNote" Style="{StaticResource Note}" Margin="0,0,0,0"
                               Text="Reading the saved permission choices…"/>
                    <StackPanel x:Name="PermissionRows" Margin="0,4,0,0"/>
                    <Button Content="Refresh permissions" Width="150" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Click="OnRefreshPermissions"
                            ToolTip="Read the running profile's saved permission choices again"/>
                    <TextBlock x:Name="PermissionDenialsText" Style="{StaticResource Note}"/>

                    <TextBlock Text="Microphone &amp; notification tests:" Margin="0,12,0,4" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Test microphone…" Width="140" Click="OnTestMicrophone"
                                ToolTip="Ask for the microphone the way a page does, then listen for a few seconds — the result says whether permission was granted AND whether sound actually arrived"/>
                        <Button Content="Send test notification" Width="160" Margin="8,0,0,0" Click="OnTestNotification"
                                ToolTip="Show a test tray notification now. A test you ask for is sent even during quiet hours — the result line says if automatic notifications are being held back"/>
                    </StackPanel>
                    <TextBlock x:Name="SelfTestResultText" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="The microphone test runs in this profile and checks the whole path Muse's voice input uses — Windows' microphone permission included. The notification test fires MuseDesktop's own tray balloon; Muse's in-page alerts are Muse's side of the fence."/>

                    <TextBlock Text="Site data per profile:" Margin="0,12,0,4" FontWeight="SemiBold"/>
                    <StackPanel x:Name="SiteDataRows"/>
                    <Button Content="Refresh site data" Width="150" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Click="OnRefreshSiteData"
                            ToolTip="Measure each profile's data folder and count its cookies again"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="Cookie counts only — cookie values are never shown anywhere in MuseDesktop."/>

                    <TextBlock Text="App lock:" Margin="0,12,0,4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AppLockStatusText" Style="{StaticResource Note}" Margin="0,0,0,0"/>
                    <CheckBox x:Name="AppLockEnabledCheck" Content="Require my app password or PIN"
                              Margin="0,6,0,0"
                              ToolTip="Ask for the app password at startup and whenever the app is locked. Setting the check asks you to create the password if you haven't yet"
                              Checked="OnAppLockEnabledChanged" Unchecked="OnAppLockEnabledChanged"/>
                    <CheckBox x:Name="AppLockTrayHideCheck" Content="Also lock when the window hides to the tray"
                              ToolTip="On by default. Startup locking and Lock now apply either way"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="SetLockPasswordButton" Content="Set or change password…" Width="170" Click="OnSetLockPassword"
                                ToolTip="Set a new app password or PIN (4–64 characters; 6 or more is better)"/>
                        <Button x:Name="RemoveLockPasswordButton" Content="Remove password…" Width="140" Margin="8,0,0,0" Click="OnRemoveLockPassword"
                                ToolTip="Remove the app password and turn the lock off"/>
                    </StackPanel>
                    <TextBlock x:Name="AppLockNote" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Style="{StaticResource Note}"
                               Text="The lock stops casual access to the open app on this PC. It does NOT encrypt your Muse sign-ins on disk. Only a salted one-way hash of the password is stored — the password itself never is. If you forget it: quit MuseDesktop, open the data folder (Data section above) and delete settings.json, then start the app — the lock is gone and settings return to defaults; your default profile stays signed in, because sign-ins live in the separate profile folders, not in settings.json."/>

                    <TextBlock Text="Privacy report:" Margin="0,12,0,4" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PrivacyReportText" Style="{StaticResource Note}" Margin="0,0,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Reset counters" Width="120" Click="OnResetPrivacyStats"
                                ToolTip="Start the privacy report's counts over from today"/>
                        <Button Content="View log…" Width="120" Margin="8,0,0,0" Click="OnViewLog"
                                ToolTip="Read the diagnostic log in the app, with its redaction check and a copy-redacted button"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}"
                               Text="The report counts only — what kind of thing was blocked, how many times, and which site. No page addresses, no content, and nothing leaves this PC."/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="OK" Width="86" Height="30" IsDefault="True" Click="OnOk"
                            Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"/>
                    <Button Content="Cancel" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
