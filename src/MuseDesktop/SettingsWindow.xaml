<Window x:Class="MuseDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MuseDesktop"
        Title="{local:Loc musedesktop_settings}"
        Width="780" Height="680" MinWidth="660" MinHeight="480" MaxHeight="1000"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <local:ProfileColorBrushConverter x:Key="ProfileColorBrush"/>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="2,1"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <!-- S6 #51: window-local styles must not lose the focus visual. -->
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
        </Style>
        <!-- R7E: a Settings section's card. Theme brushes only, so every
             theme — dark, light, and High Contrast's system colors —
             restyles it with the rest of the window. -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- R7E: a rail entry — a rounded pill when hovered or picked. -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ShellFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavPill" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavPill" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavPill" Property="Background" Value="{StaticResource RaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- R7E: the topics rail (SEAN's reference: the Muse app's own
             Settings) — search on top, then one entry per page. -->
        <Border Grid.Column="0" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,12,12,0">
                    <TextBlock Text="{local:Loc search_settings}" Margin="0,0,0,4"/>
                    <TextBox x:Name="SettingsSearchText" TextChanged="OnSearchTextChanged"
                             ToolTip="{local:Loc type_to_jump_to_a_setting_matching_sections}" KeyboardNavigation.TabIndex="1"/>
                    <TextBlock x:Name="SearchSummary" Style="{StaticResource Note}"/>
                </StackPanel>
                <ListBox x:Name="NavList" Margin="0,10,0,10"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnNavSelectionChanged"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         AutomationProperties.Name="{local:Loc settings.nav_topics}"
                         KeyboardNavigation.TabIndex="2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- One page at a time: its title, its section cards, OK/Cancel. -->
        <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitleText" Grid.Row="0" Margin="18,16,18,10"
                       FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <ScrollViewer Grid.Row="1" x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="OnSettingsScrolled">
            <StackPanel x:Name="SectionsPanel" Margin="18,0,18,16">
                <Border x:Name="CardBehavior" Style="{StaticResource SettingsCard}">
                    <StackPanel x:Name="SectionBehavior">
                        <TextBlock x:Name="HeaderBehavior" Text="{local:Loc behavior}" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="StartWithWindowsCheck" Content="{local:Loc start_with_windows}"
                                  ToolTip="{local:Loc launch_musedesktop_when_you_sign_in_to}" KeyboardNavigation.TabIndex="3"/>
                        <CheckBox x:Name="StartMinimizedCheck" Content="{local:Loc when_starting_with_windows_open_in_the_tray}"
                                  ToolTip="{local:Loc only_affects_the_sign_in_launch_on}" KeyboardNavigation.TabIndex="4"/>
                        <CheckBox x:Name="CloseToTrayCheck" Content="{local:Loc close_window_to_tray_instead_of_quitting}"
                                  ToolTip="{local:Loc the_x_button_hides_the_window_exit_lives_on}" KeyboardNavigation.TabIndex="5"/>
                        <CheckBox x:Name="SuspendInTrayCheck" Content="{local:Loc save_memory_while_hidden_in_the_tray}"
                                  ToolTip="{local:Loc after_the_time_below_the_web_view_is}" KeyboardNavigation.TabIndex="6"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{local:Loc suspend_after_hidden_for}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="SuspendTimeoutCombo" Width="130"
                                      ToolTip="{local:Loc how_long_the_window_may_sit_hidden_in_the}" KeyboardNavigation.TabIndex="7"/>
                        </StackPanel>
                        <CheckBox x:Name="CheckUpdatesCheck" Content="{local:Loc check_for_updates_when_the_app_starts}"
                                  ToolTip="{local:Loc one_silent_request_to_github_releases_per}" KeyboardNavigation.TabIndex="8"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{local:Loc check_automatically}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="UpdateFrequencyCombo" Width="210"
                                      ToolTip="{local:Loc how_often_the_automatic_check_runs_the_menu}" KeyboardNavigation.TabIndex="9"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{local:Loc release_channel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="UpdateChannelCombo" Width="210"
                                      ToolTip="{local:Loc stable_releases_only_or_also_pre_releases}" KeyboardNavigation.TabIndex="10"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{local:Loc pre_releases_are_unfinished_test_builds}"/>
                        <CheckBox x:Name="ShowWhatsNewCheck" Content="{local:Loc show_what_s_new_the_first_time_a_new}"
                                  ToolTip="{local:Loc after_an_update_the_new_version_s_release}" KeyboardNavigation.TabIndex="11"/>
                        <TextBlock x:Name="UpdateSnoozeNote" Style="{StaticResource Note}"/>
                        <Button x:Name="StopSnoozeButton" Content="{local:Loc stop_snoozing_update_reminders}" Width="210" HorizontalAlignment="Left"
                                Margin="0,4,0,0" Click="OnStopUpdateSnooze" Visibility="Collapsed"
                                ToolTip="{local:Loc cancel_the_snooze_set_from_the_update}" KeyboardNavigation.TabIndex="12"/>
                        <!-- S11 #99: musedesktop:// links. The installer
                             registers the scheme; this toggle keeps the
                             registration in line with it (and is how
                             portable installs register). The status line
                             reports the ACTUAL registration — including
                             when another app owns the scheme, which is
                             never overwritten. -->
                        <TextBlock Style="{StaticResource Note}" Margin="0,14,0,2"
                                   Text="{local:Loc links_links_that_start_with_musedesktop_can}"/>
                        <CheckBox x:Name="ProtocolLinksCheck" Content="{local:Loc let_musedesktop_links_open_musedesktop}" Margin="0,2,0,0"
                                  ToolTip="{local:Loc register_musedesktop_as_the_handler_for}" KeyboardNavigation.TabIndex="13"/>
                        <TextBlock x:Name="ProtocolStatus" Style="{StaticResource Note}" Foreground="{StaticResource AccentBrush}"/>
                        <Button Content="{local:Loc run_the_setup_wizard_again}" Width="210" HorizontalAlignment="Left"
                                Margin="0,10,0,0" Click="OnRunSetupWizard"
                                ToolTip="{local:Loc re_run_the_one_screen_first_run_setup_close}" KeyboardNavigation.TabIndex="14"/>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{local:Loc changes_apply_when_you_choose_ok_start_with}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CardTray" Style="{StaticResource SettingsCard}">
                    <StackPanel x:Name="SectionTray">
                        <TextBlock x:Name="HeaderTray" Text="{local:Loc tray_notifications}" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="TraySingleClickCheck" Content="{local:Loc single_click_the_tray_icon_to_reopen}"
                                  ToolTip="{local:Loc on_one_click_on_the_tray_icon_brings_the}" KeyboardNavigation.TabIndex="15"/>
                        <CheckBox x:Name="FlashOnAttentionCheck" Content="{local:Loc flash_the_taskbar_button_when_muse_needs}"
                                  ToolTip="{local:Loc when_muse_s_title_shows_an_unread_count}" KeyboardNavigation.TabIndex="16"/>
                        <CheckBox x:Name="ApprovalBeepCheck" Content="{local:Loc approval.beep_label}"
                                  ToolTip="{local:Loc approval.beep_tooltip}" KeyboardNavigation.TabIndex="17"/>
                        <CheckBox x:Name="QuietHoursCheck" Content="{local:Loc quiet_hours_keep_musedesktop_s_balloons_and}"
                                  ToolTip="{local:Loc during_quiet_hours_musedesktop_shows_no}" KeyboardNavigation.TabIndex="18"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{local:Loc quiet_from}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="QuietStartCombo" Width="90"
                                      ToolTip="{local:Loc quiet_hours_begin_on_the_hour}" KeyboardNavigation.TabIndex="19"/>
                            <TextBlock Text="{local:Loc to}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <ComboBox x:Name="QuietEndCombo" Width="90"
                                      ToolTip="{local:Loc quiet_hours_end_on_the_hour_earlier_than}" KeyboardNavigation.TabIndex="20"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}"
                                   Text="{local:Loc muse_s_own_in_page_notifications_are}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CardProfiles" Style="{StaticResource SettingsCard}">
                    <StackPanel x:Name="SectionProfiles">
                        <TextBlock x:Name="HeaderProfiles" Text="{local:Loc account_profiles}" Style="{StaticResource SectionHeader}"/>
                        <ComboBox x:Name="ProfileCombo" SelectionChanged="OnProfileSelectionChanged"
                                  ToolTip="{local:Loc sign_in_profiles_each_keeps_its_own_muse}" KeyboardNavigation.TabIndex="21">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{Binding DisplayColor, Converter={StaticResource ProfileColorBrush}}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,2"
                                   Text="{local:Loc name_rename_the_selected_profile}"/>
                        <TextBox x:Name="ProfileNameText" LostFocus="OnProfileNameLostFocus"
                                 ToolTip="{local:Loc the_selected_profile_s_name_shown_in_menus}" KeyboardNavigation.TabIndex="22"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="{local:Loc accent_color}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ProfileColorCombo" Width="140" SelectionChanged="OnProfileColorChanged"
                                      ToolTip="{local:Loc a_small_color_dot_next_to_this_profile_s}" KeyboardNavigation.TabIndex="23"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="{local:Loc avatar_icon}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ProfileGlyphCombo" Width="140" SelectionChanged="OnProfileGlyphChanged"
                                      ToolTip="{local:Loc a_small_symbol_shown_before_this_profile_s}" KeyboardNavigation.TabIndex="24"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="{local:Loc group}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ProfileGroupCombo" Width="140" SelectionChanged="OnProfileGroupChanged"
                                      ToolTip="{local:Loc groups_gather_profiles_under_one_heading_in}" KeyboardNavigation.TabIndex="25"/>
                            <Button x:Name="DeleteGroupButton" Content="{local:Loc delete_group}" Width="96" Margin="8,0,0,0" Click="OnDeleteProfileGroup"
                                    ToolTip="{local:Loc deletes_the_selected_group_its_profiles}" KeyboardNavigation.TabIndex="26"/>
                        </StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,6,0,0">
                            <Button x:Name="AddGroupButton" DockPanel.Dock="Right" Content="{local:Loc add_group}" Width="84" Margin="8,0,0,0"
                                    Click="OnAddProfileGroup" KeyboardNavigation.TabIndex="27"/>
                            <TextBox x:Name="NewGroupText" ToolTip="{local:Loc name_for_a_new_profile_group_e_g_clients}" KeyboardNavigation.TabIndex="28"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                   Text="{local:Loc when_this_profile_starts}"/>
                        <RadioButton x:Name="ProfileStartLastRadio" GroupName="ProfileStartPage"
                                     Content="{local:Loc reopen_the_page_it_was_last_on}" Checked="OnProfileStartModeChanged"
                                     ToolTip="{local:Loc the_profile_picks_up_where_it_left_off_the}" KeyboardNavigation.TabIndex="29"/>
                        <RadioButton x:Name="ProfileStartHomeRadio" GroupName="ProfileStartPage"
                                     Content="{local:Loc start_at_the_muse_home_page}" Checked="OnProfileStartModeChanged"
                                     ToolTip="{local:Loc this_profile_always_opens_at_muse_s_home}" KeyboardNavigation.TabIndex="30"/>
                        <RadioButton x:Name="ProfileStartCustomRadio" GroupName="ProfileStartPage"
                                     Content="{local:Loc start_at_a_specific_muse_page}" Checked="OnProfileStartModeChanged"
                                     ToolTip="{local:Loc this_profile_opens_at_the_muse_ai_page}" KeyboardNavigation.TabIndex="31"/>
                        <TextBox x:Name="ProfileCustomUrlText" Margin="18,4,0,0" LostFocus="OnProfileCustomUrlLostFocus"
                                 ToolTip="{local:Loc a_muse_ai_page_address_e_g_https_muse_ai}" KeyboardNavigation.TabIndex="32"/>
                        <TextBlock x:Name="ProfileCustomUrlNote" Style="{StaticResource Note}" Margin="18,2,0,0"/>
                        <CheckBox x:Name="ProfileZoomCheck" Content="{local:Loc use_a_custom_zoom_for_this_profile}"
                                  Checked="OnProfileZoomChanged" Unchecked="OnProfileZoomChanged"
                                  ToolTip="{local:Loc on_this_profile_zooms_independently_off_it}" KeyboardNavigation.TabIndex="33"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{local:Loc profile_zoom}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ProfileZoomCombo" Width="90" SelectionChanged="OnProfileZoomComboChanged"
                                      ToolTip="{local:Loc this_profile_s_own_zoom_used_while_the}" KeyboardNavigation.TabIndex="34"/>
                        </StackPanel>
                        <TextBlock x:Name="ProfileDataText" Style="{StaticResource Note}" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="{local:Loc data_size_cap}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ProfileDataCapCombo" Width="150" SelectionChanged="OnProfileDataCapChanged"
                                      ToolTip="{local:Loc optional_cap_on_this_profile_s_data_folder}" KeyboardNavigation.TabIndex="35"/>
                        </StackPanel>
                        <TextBlock x:Name="ProfileCapNote" Style="{StaticResource Note}"/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,8,0,2"
                                   Text="{local:Loc downloads_folder_for_this_profile_optional}"/>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ClearProfileFolderButton" DockPanel.Dock="Right" Content="{local:Loc clear}" Width="56" Margin="8,0,0,0"
                                    Click="OnClearProfileDownloadsFolder"
                                    ToolTip="{local:Loc remove_this_profile_s_downloads_folder}" KeyboardNavigation.TabIndex="36"/>
                            <Button x:Name="BrowseProfileFolderButton" DockPanel.Dock="Right" Content="{local:Loc browse}" Width="76" Margin="8,0,0,0"
                                    Click="OnBrowseProfileDownloadsFolder" KeyboardNavigation.TabIndex="37"/>
                            <TextBox x:Name="ProfileDownloadsFolderText" IsReadOnly="True"
                                     ToolTip="{local:Loc this_profile_s_downloads_land_here_empty}" KeyboardNavigation.TabIndex="38"/>
                        </DockPanel>
                        <CheckBox x:Name="ProfileArchivedCheck" Content="{local:Loc archive_this_profile_hide_it_from_switchers}"
                                  Margin="0,10,0,0" Checked="OnProfileArchivedChanged" Unchecked="OnProfileArchivedChanged"
                                  ToolTip="{local:Loc archived_profiles_disappear_from_the}" KeyboardNavigation.TabIndex="39"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="{local:Loc profile_pin}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ProfilePinStatus" VerticalAlignment="Center"/>
                            <Button x:Name="SetProfilePinButton" Content="{local:Loc set_pin}" Width="84" Margin="8,0,0,0" Click="OnSetProfilePin"
                                    ToolTip="{local:Loc ask_for_a_pin_whenever_musedesktop_launches}" KeyboardNavigation.TabIndex="40"/>
                            <Button x:Name="RemoveProfilePinButton" Content="{local:Loc remove_pin}" Width="96" Margin="8,0,0,0" Click="OnRemoveProfilePin"
                                    ToolTip="{local:Loc remove_this_profile_s_pin_asks_for_the}" KeyboardNavigation.TabIndex="41"/>
                        </StackPanel>
                        <CheckBox x:Name="ProfileScheduleCheck" Content="{local:Loc switch_to_this_profile_on_a_schedule}"
                                  Margin="0,10,0,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged"
                                  ToolTip="{local:Loc during_the_hours_below_musedesktop_offers}" KeyboardNavigation.TabIndex="42"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,4,0,0">
                            <TextBlock Text="{local:Loc from}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="ProfileScheduleStartText" Width="56" LostFocus="OnProfileScheduleChanged"
                                     ToolTip="{local:Loc start_time_24_hour_clock_e_g_09_00}" KeyboardNavigation.TabIndex="43"/>
                            <TextBlock Text="{local:Loc to_2}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                            <TextBox x:Name="ProfileScheduleEndText" Width="56" LostFocus="OnProfileScheduleChanged"
                                     ToolTip="{local:Loc end_time_24_hour_clock_e_g_17_00_an_end}" KeyboardNavigation.TabIndex="44"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="18,4,0,0">
                            <CheckBox x:Name="SchedMon" Content="{local:Loc mon}" Margin="0,0,8,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged" KeyboardNavigation.TabIndex="45"/>
                            <CheckBox x:Name="SchedTue" Content="{local:Loc tue}" Margin="0,0,8,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged" KeyboardNavigation.TabIndex="46"/>
                            <CheckBox x:Name="SchedWed" Content="{local:Loc wed}" Margin="0,0,8,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged" KeyboardNavigation.TabIndex="47"/>
                            <CheckBox x:Name="SchedThu" Content="{local:Loc thu}" Margin="0,0,8,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged" KeyboardNavigation.TabIndex="48"/>
                            <CheckBox x:Name="SchedFri" Content="{local:Loc fri}" Margin="0,0,8,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged" KeyboardNavigation.TabIndex="49"/>
                            <CheckBox x:Name="SchedSat" Content="{local:Loc sat}" Margin="0,0,8,0" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged" KeyboardNavigation.TabIndex="50"/>
                            <CheckBox x:Name="SchedSun" Content="{local:Loc sun}" Checked="OnProfileScheduleChanged" Unchecked="OnProfileScheduleChanged" KeyboardNavigation.TabIndex="51"/>
                        </StackPanel>
                        <TextBlock x:Name="ProfileScheduleText" Style="{StaticResource Note}" Margin="18,2,0,0"/>
                        <CheckBox x:Name="ScheduleAutoCheck" Content="{local:Loc switch_automatically_when_a_schedule_starts}"
                                  Margin="18,4,0,0" Checked="OnScheduleAutoChanged" Unchecked="OnScheduleAutoChanged"
                                  ToolTip="{local:Loc off_the_default_when_a_scheduled_time}" KeyboardNavigation.TabIndex="52"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="RefreshProfileHealthButton" Content="{local:Loc profile_health}" Width="110" Click="OnRefreshProfileHealth"
                                    ToolTip="{local:Loc counts_only_this_profile_s_data_size}" KeyboardNavigation.TabIndex="53"/>
                            <Button x:Name="ClearProfileUsageButton" Content="{local:Loc clear_usage_counts}" Width="140" Margin="8,0,0,0" Click="OnClearProfileUsage"
                                    ToolTip="{local:Loc deletes_the_launch_counts_for_every_profile}" KeyboardNavigation.TabIndex="54"/>
                        </StackPanel>
                        <TextBlock x:Name="ProfileHealthText" Style="{StaticResource Note}"/>
                        <TextBlock x:Name="ProfileUsageText" Style="{StaticResource Note}" Margin="0,4,0,0"/>
                        <!-- R5B (#201/#204/#205/#206): the conversation view
                             for the selected profile. These apply small,
                             user-chosen touches to the Muse page inside
                             this app (a visible scrollbar, text size,
                             column width, line spacing) — nothing else
                             about the page is changed, and they apply
                             when you press OK. -->
                        <TextBlock Style="{StaticResource Note}" Margin="0,12,0,2"
                                   Text="{local:Loc conversation_view_for_the_selected_profile}"/>
                        <CheckBox x:Name="ProfileScrollbarsCheck" Content="{local:Loc always_show_the_conversation_scrollbar}"
                                  Checked="OnProfileViewChanged" Unchecked="OnProfileViewChanged"
                                  ToolTip="{local:Loc muse_s_own_scrollbar_hides_until_you_scroll}" KeyboardNavigation.TabIndex="55"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Text="{local:Loc chat_text_size}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ChatTextScaleCombo" Width="90" SelectionChanged="OnProfileViewChanged"
                                      ToolTip="{local:Loc scales_the_conversation_s_text_separate}" KeyboardNavigation.TabIndex="56"/>
                            <TextBlock Text="{local:Loc reading_column}" VerticalAlignment="Center" Margin="14,0,8,0"/>
                            <ComboBox x:Name="ReadingColumnCombo" Width="128" SelectionChanged="OnProfileViewChanged"
                                      ToolTip="{local:Loc how_wide_the_conversation_column_may_grow}" KeyboardNavigation.TabIndex="57"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                            <TextBlock Text="{local:Loc line_spacing}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="LineSpacingCombo" Width="128" SelectionChanged="OnProfileViewChanged"
                                      ToolTip="{local:Loc space_between_lines_in_messages_page}" KeyboardNavigation.TabIndex="58"/>
                        </StackPanel>
                        <CheckBox x:Name="DraftsAutosaveCheck" Content="{local:Loc keep_unsent_message_drafts_per_conversation}"
                                  Margin="0,8,0,0" Checked="OnDraftsAutosaveChanged" Unchecked="OnDraftsAutosaveChanged"
                                  ToolTip="{local:Loc what_you_type_in_a_conversation_s_message}" KeyboardNavigation.TabIndex="59"/>
                        <TextBlock Style="{StaticResource Note}" Margin="0,10,0,2"
