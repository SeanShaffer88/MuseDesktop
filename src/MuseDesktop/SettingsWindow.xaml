<Window x:Class="MuseDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MuseDesktop"
        Title="MuseDesktop Settings"
        Width="480" SizeToContent="Height" MaxHeight="720"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <local:ProfileColorBrushConverter x:Key="ProfileColorBrush"/>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,6,18,16">
            <TextBlock Text="Behavior" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows"
                      ToolTip="Launch MuseDesktop when you sign in to Windows (the usual per-user Run entry)"/>
            <CheckBox x:Name="StartMinimizedCheck" Content="When starting with Windows, open in the tray (not on screen)"
                      ToolTip="Only affects the sign-in launch: on = MuseDesktop waits in the tray; off = the window opens like a normal launch. Double-clicking the app always opens the window"/>
            <CheckBox x:Name="CloseToTrayCheck" Content="Close window to tray (instead of quitting)"
                      ToolTip="The X button hides the window; Exit lives on the tray menu"/>
            <CheckBox x:Name="SuspendInTrayCheck" Content="Save memory while hidden in the tray"
                      ToolTip="After the time below, the web view is suspended until you come back. Suspend never happens during a download, and stays out of the way after the microphone has been used (a voice session may be live)"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="Suspend after hidden for:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SuspendTimeoutCombo" Width="130"
                          ToolTip="How long the window may sit hidden in the tray before the web view suspends"/>
            </StackPanel>
            <CheckBox x:Name="CheckUpdatesCheck" Content="Check for updates when the app starts"
                      ToolTip="One silent request to GitHub Releases per launch; failures are ignored"/>
            <TextBlock Style="{StaticResource Note}"
                       Text="Changes apply when you choose OK. Start-with-Windows writes the usual per-user Run entry; nothing here phones home beyond the update check you control."/>

            <TextBlock Text="Tray &amp; notifications" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="TraySingleClickCheck" Content="Single-click the tray icon to reopen (instead of double-click)"
                      ToolTip="On: one click on the tray icon brings the window back. Off: double-click, as always"/>
            <CheckBox x:Name="FlashOnAttentionCheck" Content="Flash the taskbar button when Muse needs attention while I'm away"
                      ToolTip="When Muse's title shows an unread count (like (2) Muse) and you're not looking at the window, the taskbar button flashes a few times — it never steals focus. Off by default"/>
            <CheckBox x:Name="QuietHoursCheck" Content="Quiet hours: keep MuseDesktop's balloons and flashes silent"
                      ToolTip="During quiet hours MuseDesktop shows no tray balloons and no taskbar flash (the suppression is written to the log, never silent). Your Windows Do Not Disturb setting is always respected too"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="Quiet from:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="QuietStartCombo" Width="90"
                          ToolTip="Quiet hours begin (on the hour)"/>
                <TextBlock Text="to:" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <ComboBox x:Name="QuietEndCombo" Width="90"
                          ToolTip="Quiet hours end (on the hour) — earlier than the start is fine; the window wraps midnight"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Note}"
                       Text="Muse's own in-page notifications are governed by Windows and Muse, not by these settings. The tray icon also shows your active profile's accent color as a small dot, and an unread-count badge when Muse's title provides one."/>

            <TextBlock Text="Account profiles" Style="{StaticResource SectionHeader}"/>
            <ComboBox x:Name="ProfileCombo" SelectionChanged="OnProfileSelectionChanged"
                      ToolTip="Sign-in profiles — each keeps its own Muse session">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{Binding DisplayColor, Converter={StaticResource ProfileColorBrush}}"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Style="{StaticResource Note}" Margin="0,8,0,2"
                       Text="Name (rename the selected profile):"/>
            <TextBox x:Name="ProfileNameText" LostFocus="OnProfileNameLostFocus"
                     ToolTip="The selected profile's name, shown in menus and the tray"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="Accent color:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProfileColorCombo" Width="140" SelectionChanged="OnProfileColorChanged"
                          ToolTip="A small color dot next to this profile's name in menus, the tray, and here"/>
            </StackPanel>
            <CheckBox x:Name="ProfileStartHomeCheck" Content="Start this profile at the Muse home page"
                      Checked="OnProfileStartHomeChanged" Unchecked="OnProfileStartHomeChanged"
                      ToolTip="On: this profile opens at Muse's home page. Off: it reopens the page it was last on"/>
            <CheckBox x:Name="ProfileZoomCheck" Content="Use a custom zoom for this profile"
                      Checked="OnProfileZoomChanged" Unchecked="OnProfileZoomChanged"
                      ToolTip="On: this profile zooms independently. Off: it uses the shared default zoom below. Zooming in the app updates the custom zoom while it's on"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="Profile zoom:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProfileZoomCombo" Width="90" SelectionChanged="OnProfileZoomComboChanged"/>
            </StackPanel>
            <TextBlock x:Name="ProfileDataText" Style="{StaticResource Note}" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource Note}" Margin="0,8,0,2"
                       Text="Downloads folder for this profile (optional — overrides the shared folder below):"/>
            <DockPanel LastChildFill="True">
                <Button x:Name="ClearProfileFolderButton" DockPanel.Dock="Right" Content="Clear" Width="56" Margin="8,0,0,0"
                        Click="OnClearProfileDownloadsFolder"
                        ToolTip="Remove this profile's downloads-folder override"/>
                <Button x:Name="BrowseProfileFolderButton" DockPanel.Dock="Right" Content="Browse…" Width="76" Margin="8,0,0,0"
                        Click="OnBrowseProfileDownloadsFolder"/>
                <TextBox x:Name="ProfileDownloadsFolderText" IsReadOnly="True"
                         ToolTip="This profile's downloads land here; empty uses the shared Downloads folder"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="SwitchProfileButton" Content="Switch to this profile" Width="150" Click="OnSwitchProfile"
                        ToolTip="Restarts MuseDesktop signed in with the selected profile"/>
                <Button x:Name="RemoveProfileButton" Content="Remove" Width="76" Margin="8,0,0,0" Click="OnRemoveProfile"
                        ToolTip="Removes the profile; its local sign-in data is deleted when you choose OK"/>
                <Button x:Name="CreateShortcutButton" Content="Create desktop shortcut" Width="164" Margin="8,0,0,0" Click="OnCreateProfileShortcut"
                        ToolTip="Puts a shortcut on the Desktop that opens MuseDesktop with this profile"/>
            </StackPanel>
            <TextBlock x:Name="ProfileNote" Style="{StaticResource Note}"/>
            <TextBlock Style="{StaticResource Note}" Margin="0,8,0,2"
                       Text="New profile — optionally copy settings (start page, downloads folder, zoom, color) from an existing one. Sign-ins are never copied:"/>
            <ComboBox x:Name="CopyFromCombo" SelectionChanged="OnCopyFromChanged"
                      ToolTip="Copy the new profile's settings from this profile; its sign-in is never copied"/>
            <DockPanel LastChildFill="True" Margin="0,6,0,0">
                <Button x:Name="AddProfileButton" DockPanel.Dock="Right" Content="Add" Width="76" Margin="8,0,0,0"
                        Click="OnAddProfile"/>
                <TextBox x:Name="NewProfileNameText" ToolTip="Name for a new profile, e.g. Work"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Note}"
                       Text="Each profile is a separate Muse sign-in (its own cookies and data on this PC). Switching restarts the app immediately, discarding other unsaved changes in this window. You can't remove the profile you're currently using."/>

            <TextBlock Text="Zoom" Style="{StaticResource SectionHeader}"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Default zoom:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ZoomCombo" Width="90"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Note}"
                       Text="Applies immediately at OK and is where the toolbar zoom starts next launch."/>

            <TextBlock Text="Downloads" Style="{StaticResource SectionHeader}"/>
            <DockPanel LastChildFill="True">
                <Button x:Name="BrowseFolderButton" DockPanel.Dock="Right" Content="Browse…" Width="76" Margin="8,0,0,0"
                        Click="OnBrowseDownloadsFolder"/>
                <TextBox x:Name="DownloadsFolderText" IsReadOnly="True"
                         ToolTip="Where downloads are saved"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Note}"
                       Text="Empty means your Windows Downloads folder. Changing it does not move files already downloaded."/>
            <CheckBox x:Name="AskWhereToSaveCheck" Content="Ask where to save each download"
                      ToolTip="Shows a Save-As dialog for every file"/>
            <CheckBox x:Name="NotifyDownloadCompleteCheck" Content="Tell me when a download finishes while the window is hidden"
                      ToolTip="Shows a tray balloon naming the file. Off by default; never makes a sound"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="If the file already exists:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CollisionPolicyCombo" Width="210"
                          ToolTip="Save under a new name automatically, or ask where to save that file"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="Keep download history:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="HistoryCapCombo" Width="120"
                          ToolTip="How many finished downloads the Downloads window remembers"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Note}"
                       Text="History keeps names, sizes, dates, and paths only — never the addresses files came from. Failed downloads are listed too."/>

            <TextBlock Text="Data" Style="{StaticResource SectionHeader}"/>
            <Button x:Name="ClearDataButton" Content="Clear browsing data and sign out…" Width="230"
                    HorizontalAlignment="Left" Click="OnClearData"
                    ToolTip="Removes cookies, cache, and site data from MuseDesktop's own profile"/>
            <TextBlock x:Name="ClearDataNote" Style="{StaticResource Note}"
                       Text="Deletes cookies, cache, and site data stored by MuseDesktop — you will sign in to Muse again. Your chats live in your Muse account and are not affected."/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Export settings…" Width="130" Click="OnExportSettings"
                        ToolTip="Save these settings to a file you can keep or move to another PC"/>
                <Button Content="Import settings…" Width="130" Margin="8,0,0,0" Click="OnImportSettings"
                        ToolTip="Replace these settings with ones from an exported file"/>
            </StackPanel>
            <TextBlock x:Name="ImportNote" Style="{StaticResource Note}"
                       Text="Export saves the settings shown here (including profiles and per-profile start pages) as a small JSON file. Sign-ins themselves are not exported — those stay in each profile's own data."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="OK" Width="86" Height="30" IsDefault="True" Click="OnOk"
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                <Button Content="Cancel" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
