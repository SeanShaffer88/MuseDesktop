<Window x:Class="MuseDesktop.TokenUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MuseDesktop"
        Title="{local:Loc token.usage}"
        Width="440" MinWidth="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="Height"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <!-- R7B: the token ring's panel. Three lines, all catalog-fed:
         the reading itself (counts when they exist, else the
         percent), the SOURCE stated plainly (the page reported it /
         it is an estimate and why), and — estimate mode only — the
         note that the limit it is measured against is a setting. -->
    <StackPanel Margin="18,14,18,14">
        <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="SourceText" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"/>
        <TextBlock x:Name="NoteText" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{local:Loc refresh}" Width="86" Height="30" Click="OnRefresh"
                    KeyboardNavigation.TabIndex="1"/>
            <Button Content="{local:Loc close}" Width="86" Height="30" Margin="8,0,0,0"
                    IsDefault="True" IsCancel="True"
                    Background="{StaticResource AccentFillBrush}" Foreground="{StaticResource AccentTextBrush}" BorderThickness="0"
                    KeyboardNavigation.TabIndex="2"/>
        </StackPanel>
    </StackPanel>
</Window>
