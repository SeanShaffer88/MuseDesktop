<Window x:Class="MuseDesktop.ProductivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weekly digest &amp; stats"
        Width="600" Height="540" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="14,12,14,12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ClearStatsButton" Content="Clear stats data" Width="124" Height="28" Click="OnClearStats"
                    AutomationProperties.Name="Clear stats data"/>
            <Button Content="Close" Width="84" Height="28" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <TabControl x:Name="Tabs" AutomationProperties.Name="Productivity views"
                    Background="{StaticResource SurfaceBrush}"
                    Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource HairlineBrush}">
            <TabItem Header="Weekly digest" AutomationProperties.Name="Weekly digest tab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <TextBlock x:Name="DigestText" TextWrapping="Wrap" FontSize="13"
                               AutomationProperties.Name="Weekly digest text"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Stats dashboard" AutomationProperties.Name="Stats dashboard tab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel x:Name="StatsPanel"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
