<Window x:Class="MuseDesktop.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{local:Loc musedesktop_log}"
        Width="760" Height="560" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" xmlns:local="clr-namespace:MuseDesktop">
    <Window.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14,12,14,12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="AuditText" Style="{StaticResource Note}" Margin="0,0,0,0"
                       AutomationProperties.Name="{local:Loc redaction_check_result}"/>
            <TextBlock x:Name="FindingsText" Style="{StaticResource Note}"
                       AutomationProperties.Name="{local:Loc redaction_findings_by_line}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="CopyNote" Style="{StaticResource Note}" Margin="0,4,10,0"/>
            <Button Content="{local:Loc copy_redacted_log}" Width="140" Height="30" Click="OnCopyRedacted"
                    ToolTip="{local:Loc copy_the_log_with_anything_the_redaction}" KeyboardNavigation.TabIndex="1"/>
            <Button Content="{local:Loc copy_last_error}" Width="120" Height="30" Margin="8,0,0,0" Click="OnCopyLastError"
                    ToolTip="{local:Loc copy_just_the_most_recent_error_line}" KeyboardNavigation.TabIndex="2"/>
            <Button Content="{local:Loc open_today_s_log}" Width="120" Height="30" Margin="8,0,0,0" Click="OnOpenLog"
                    ToolTip="{local:Loc open_the_log_file_itself_in_your_default}" KeyboardNavigation.TabIndex="3"/>
            <Button Content="{local:Loc refresh}" Width="86" Height="30" Margin="8,0,0,0" Click="OnRefresh"
                    ToolTip="{local:Loc read_the_log_file_again}" KeyboardNavigation.TabIndex="4"/>
            <Button Content="{local:Loc close}" Width="86" Height="30" Margin="8,0,0,0" IsCancel="True" KeyboardNavigation.TabIndex="5"/>
        </StackPanel>

        <TextBox x:Name="LogText" Margin="0,10,0,0" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="12"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource HairlineBrush}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 AutomationProperties.Name="{local:Loc log_contents}" KeyboardNavigation.TabIndex="6"/>
    </DockPanel>
</Window>
