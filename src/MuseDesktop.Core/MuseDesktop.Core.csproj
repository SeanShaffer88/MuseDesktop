<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.8.4</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The string catalog (R7 #161): the en-US source table and the
         full es-ES translation ship as embedded JSON data, loaded by
         StringCatalog. JSON (not .resx) so language packs (#165) share
         exactly the validated shape. -->
    <!-- WithCulture=false matters: the file names contain culture-
         looking segments (en-US / es-ES), which MSBuild would
         otherwise treat as satellite-assembly resources and keep out
         of the main assembly StringCatalog loads from. -->
    <EmbeddedResource Include="Strings.en-US.json" WithCulture="false" />
    <EmbeddedResource Include="Strings.es-ES.json" WithCulture="false" />
  </ItemGroup>

</Project>
